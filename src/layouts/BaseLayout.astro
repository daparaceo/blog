---
import { getCollection } from 'astro:content';

const learnPosts = await getCollection('learn', ({ data }) => !data.draft);
const hasEnglish = learnPosts.length > 0;

const navLinks = [
  ...(hasEnglish ? [{ href: '/learn/english/books/', label: '영어원서' }] : []),
  { href: '/learn/certs/security/', label: '정보보안기사' },
  { href: '/search/library/', label: '도서관 검색' },
];

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  isArticle?: boolean;
  publishedDate?: string;
  noindex?: boolean;
}

const {
  title,
  description = '깊이 파고들고, 깊이 배워, 오래가는 가치를 만듭니다.',
  ogImage = '/og-default.png',
  isArticle = false,
  publishedDate,
  noindex = false,
} = Astro.props;

const SITE_NAME = 'daparapara';           // ← 블로그 이름 (변경 가능)
const siteUrl   = Astro.site?.href.replace(/\/$/, '') ?? 'https://daparapara.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content={isArticle ? 'article' : 'website'} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
  <meta property="og:locale"      content="ko_KR" />
  <meta property="og:site_name"   content={SITE_NAME} />
  {isArticle && publishedDate && (
    <meta property="article:published_time" content={publishedDate} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0ea5e9" />
  <meta name="apple-mobile-web-app-title" content="daparapara" />
  <meta name="apple-mobile-web-app-capable" content="yes" />

  <!-- 네이버 서치어드바이저 소유권 확인 -->
  <meta name="naver-site-verification" content="6e02e575a21cec8481c63efac68fa4eb15350fba" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FBR7CMBCPX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-FBR7CMBCPX');
  </script>

  <!-- 구글 애드센스 Auto Ads -->
  <script async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4251470918961546"
    crossorigin="anonymous">
  </script>

  <!-- 카카오 애드핏 -->
  <script async src="//t1.kakaocdn.net/kas/static/ba.min.js"></script>

</head>

<body class="min-h-screen bg-white text-gray-800 flex flex-col">

  <!-- 헤더 -->
  <header class="border-b border-gray-200 sticky top-0 bg-white/90 backdrop-blur z-10">
    <div class="max-w-3xl mx-auto px-4">
      <!-- 상단 로고 + 주요 링크 -->
      <div class="flex items-center justify-between py-3">
        <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity" aria-label="daparapara 홈">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 20" width="18" height="16" aria-hidden="true">
            <rect x="0"  y="0"   width="6" height="20" rx="3"   fill="#0ea5e9"/>
            <rect x="9"  y="3.5" width="6" height="13" rx="3"   fill="#0ea5e9"/>
            <rect x="18" y="6.5" width="5" height="7"  rx="2.5" fill="#0ea5e9"/>
          </svg>
          <span class="text-xl font-bold text-gray-900">{SITE_NAME}</span>
        </a>
        <a href="/search/" class="hover:text-brand-600 transition-colors text-gray-600" aria-label="검색">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
          </svg>
        </a>
      </div>

      <!-- 포탈 네비게이션 -->
      <nav class="flex gap-4 pb-2 text-sm overflow-x-auto">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="whitespace-nowrap text-gray-500 hover:text-brand-600 transition-colors pb-1 border-b-2 border-transparent hover:border-brand-400"
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <div
    id="install-shortcut"
    class="hidden fixed inset-x-3 bottom-3 z-50 mx-auto max-w-sm rounded-lg border border-sky-100 bg-white p-3 shadow-lg"
    role="region"
    aria-label="홈 화면 바로가기"
  >
    <div class="flex items-start gap-3">
      <img src="/apple-touch-icon.png" alt="" class="h-10 w-10 shrink-0 rounded-xl" loading="lazy" />
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold text-gray-900">daparapara 바로가기</p>
        <p id="install-shortcut-message" class="mt-0.5 text-xs leading-5 text-gray-600">
          홈 화면에 추가해 빠르게 열 수 있습니다.
        </p>
        <div class="mt-2 flex items-center gap-2">
          <button
            id="install-shortcut-action"
            type="button"
            class="rounded-md bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-700"
          >
            추가
          </button>
          <button
            id="install-shortcut-close"
            type="button"
            class="rounded-md px-2.5 py-1.5 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700"
            aria-label="닫기"
          >
            닫기
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 메인 콘텐츠 -->
  <main class="flex-grow max-w-3xl mx-auto w-full px-4 py-10">
    <slot />
  </main>

  <!-- 푸터 -->
  <footer class="border-t border-gray-200 mt-auto">
    <div class="max-w-3xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</p>
      <p class="mt-1 text-gray-400">오래가는 가치를 만듭니다.</p>
      <p class="mt-2">
        <a href="/privacy/" class="hover:text-brand-600 underline">개인정보처리방침</a>
        &nbsp;·&nbsp;
        <a href="/about/" class="hover:text-brand-600 underline">소개</a>
      </p>
    </div>
  </footer>

  <script>
    const shortcutBanner = document.getElementById('install-shortcut');
    const shortcutAction = document.getElementById('install-shortcut-action');
    const shortcutClose = document.getElementById('install-shortcut-close');
    const shortcutMessage = document.getElementById('install-shortcut-message');
    const shortcutDismissedKey = 'daparapara-install-shortcut-dismissed';
    let installPromptEvent = null;

    function isStandaloneMode() {
      return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    }

    function isMobileSafari() {
      const ua = window.navigator.userAgent;
      return /iPhone|iPad|iPod/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
    }

    function showShortcutBanner() {
      if (!shortcutBanner || isStandaloneMode() || localStorage.getItem(shortcutDismissedKey) === '1') return;
      shortcutBanner.classList.remove('hidden');
    }

    function hideShortcutBanner() {
      shortcutBanner?.classList.add('hidden');
    }

    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      installPromptEvent = event;
      shortcutMessage.textContent = '홈 화면에 추가해 앱처럼 빠르게 열 수 있습니다.';
      shortcutAction.textContent = '추가';
      showShortcutBanner();
    });

    shortcutAction?.addEventListener('click', async () => {
      if (installPromptEvent) {
        installPromptEvent.prompt();
        await installPromptEvent.userChoice;
        installPromptEvent = null;
        hideShortcutBanner();
        return;
      }

      if (isMobileSafari()) {
        shortcutMessage.textContent = 'Safari 공유 버튼을 누른 뒤 홈 화면에 추가를 선택하세요.';
      }
    });

    shortcutClose?.addEventListener('click', () => {
      localStorage.setItem(shortcutDismissedKey, '1');
      hideShortcutBanner();
    });

    window.addEventListener('appinstalled', () => {
      installPromptEvent = null;
      hideShortcutBanner();
    });

    document.addEventListener('DOMContentLoaded', () => {
      if (!shortcutAction || !shortcutMessage) return;

      if (isMobileSafari()) {
        shortcutAction.textContent = '방법 보기';
        shortcutMessage.textContent = 'Safari에서 홈 화면 바로가기를 만들 수 있습니다.';
        showShortcutBanner();
      }
    });
  </script>

  <!-- TTS: data-word 속성이 있는 요소 클릭 시 음성 재생 -->
  <script>
    // 페이지 로드 시 모든 data-word 요소를 미리 fetch + Audio 객체 생성
    const ttsCache = new Map(); // text -> Audio

    function preloadTTS(text, lang) {
      if (ttsCache.has(text)) return;
      ttsCache.set(text, null); // pending 표시
      fetch(`https://api.daparapara.com/tts?text=${encodeURIComponent(text)}&lang=${lang}`)
        .then(res => res.json())
        .then(data => {
          if (data.url) {
            const audio = new Audio(data.url);
            audio.preload = 'auto';
            ttsCache.set(text, audio);
          }
        })
        .catch(() => { ttsCache.delete(text); });
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('[data-word]').forEach(el => {
        preloadTTS(el.dataset.word, el.dataset.lang || 'en-US');
      });
    });

    document.addEventListener('click', function(e) {
      const item = e.target.closest('[data-word]');
      if (!item) return;

      const text = item.dataset.word;
      const lang = item.dataset.lang || 'en-US';
      const cached = ttsCache.get(text);

      if (cached) {
        cached.currentTime = 0;
        cached.play();
        return;
      }

      // 캐시 미스 시 fallback (preload 중이거나 실패한 경우)
      item.style.opacity = '0.6';
      fetch(`https://api.daparapara.com/tts?text=${encodeURIComponent(text)}&lang=${lang}`)
        .then(res => res.json())
        .then(data => {
          if (data.url) {
            const audio = new Audio(data.url);
            ttsCache.set(text, audio);
            audio.play();
          }
        })
        .catch(e => console.error('TTS 오류:', e))
        .finally(() => { item.style.opacity = '1'; });
    });
  </script>

  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "279b6eaef54f4c39b00ed3da7817800f"}'></script>
  <!-- End Cloudflare Web Analytics -->
</body>
</html>
