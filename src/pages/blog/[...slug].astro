---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('learn', ({ data }) => data.draft !== true);
  return posts.map((post) => {
    const bareSlug = post.slug.includes('/') ? post.slug.split('/').pop()! : post.slug;
    return {
      params: { slug: bareSlug },
      props: { bareSlug },
    };
  });
}

const { bareSlug } = Astro.props;
const redirectTo = `/learn/english/books/${bareSlug}/`;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
  <link rel="canonical" href={`https://daparapara.com${redirectTo}`} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <script define:vars={{ redirectTo }}>window.location.replace(redirectTo);</script>
</body>
</html>
