---
// src/pages/tools.astro
// QR코드 · 바코드 생성기 — 사이트맵 미노출, /tools 직접 접근
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="QR · 바코드 생성기" description="QR코드와 바코드를 무료로 생성하고 다운로드하세요.">
  <div class="max-w-xl mx-auto px-4 py-8">

    <h1 class="text-2xl font-bold text-gray-900 mb-6">Tools</h1>

    <!-- 탭 -->
    <div class="flex gap-1 bg-gray-100 p-1 rounded-xl mb-6">
      <button id="tab-qr"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-gray-900 shadow-sm transition-all"
        onclick="switchTab('qr')">QR 코드 생성</button>
      <button id="tab-bar"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg text-gray-500 transition-all"
        onclick="switchTab('bar')">바코드 생성</button>
      <button id="tab-book"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg text-gray-500 transition-all"
        onclick="switchTab('book')">영어원서 포스트 생성</button>
    </div>

    <!-- ── QR 코드 패널 ─────────────────────────────────── -->
    <div id="panel-qr">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">내용 (URL 또는 텍스트)</label>
          <input id="qr-input" type="text" placeholder="https://daparapara.com"
            class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">크기</label>
            <select id="qr-size"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="128">128 px</option>
              <option value="256" selected>256 px</option>
              <option value="512">512 px</option>
            </select>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">오류 복원</label>
            <select id="qr-ec"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="L">낮음 (L)</option>
              <option value="M" selected>보통 (M)</option>
              <option value="Q">높음 (Q)</option>
              <option value="H">최고 (H)</option>
            </select>
          </div>
        </div>

        <button onclick="generateQr()"
          class="w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">
          생성하기
        </button>
      </div>

      <div id="qr-result" class="hidden mt-6 text-center">
        <div class="inline-block bg-white border border-gray-200 rounded-2xl p-4 shadow-sm">
          <div id="qr-canvas-wrap"></div>
        </div>
        <div class="mt-4">
          <button onclick="downloadQr()"
            class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 active:scale-95 transition-all">
            PNG 다운로드
          </button>
        </div>
      </div>

      <p id="qr-error" class="hidden mt-3 text-sm text-red-500 text-center"></p>
    </div>

    <!-- ── 바코드 패널 ──────────────────────────────────── -->
    <div id="panel-bar" class="hidden">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">내용</label>
          <input id="bar-input" type="text" placeholder="978-89-12345-00-3"
            class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">형식</label>
            <select id="bar-format"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="CODE128">CODE 128 (일반)</option>
              <option value="EAN13">EAN-13 (ISBN)</option>
              <option value="EAN8">EAN-8</option>
              <option value="UPCA">UPC-A</option>
              <option value="CODE39">CODE 39</option>
            </select>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">텍스트 표시</label>
            <select id="bar-label"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="1" selected>표시</option>
              <option value="0">숨김</option>
            </select>
          </div>
        </div>

        <button onclick="generateBar()"
          class="w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">
          생성하기
        </button>
      </div>

      <div id="bar-result" class="hidden mt-6 text-center">
        <div class="inline-block bg-white border border-gray-200 rounded-2xl p-4 shadow-sm overflow-x-auto max-w-full">
          <svg id="bar-svg"></svg>
        </div>
        <div class="mt-4">
          <button onclick="downloadBar()"
            class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 active:scale-95 transition-all">
            PNG 다운로드
          </button>
        </div>
      </div>

      <p id="bar-error" class="hidden mt-3 text-sm text-red-500 text-center"></p>
    </div>

    <!-- ── 포스트 생성 패널 ───────────────────────────────── -->
    <div id="panel-book" class="hidden">
      <p class="text-sm text-gray-500 mb-4">ISBN을 입력하면 영어원서 블로그 포스트를 자동 생성합니다.</p>

      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ISBN (10~13자리 숫자)</label>
          <input id="book-isbn" type="text" placeholder="9781234567890"
            inputmode="numeric"
            class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
        </div>
        <div class="flex gap-2">
          <button id="btn-generate" onclick="generatePost(false)"
            class="flex-1 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">
            포스트 생성
          </button>
          <button id="btn-force" onclick="generatePost(true)"
            class="px-4 py-2.5 bg-gray-100 text-gray-600 text-sm font-semibold rounded-xl hover:bg-gray-200 active:scale-95 transition-all"
            title="이미 생성된 포스트도 재생성">
            강제 재생성
          </button>
        </div>
      </div>

      <!-- 진행 상태 -->
      <div id="book-progress" class="hidden mt-5 space-y-2">
        <div id="step-1" class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 text-sm text-gray-500">
          <span id="step-1-icon" class="text-base">○</span>
          <span>Phase 1 — 도서 기본 정보 수집</span>
        </div>
        <div id="step-2" class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 text-sm text-gray-500">
          <span id="step-2-icon" class="text-base">○</span>
          <span>Phase 2 — AR + YouTube 자막 수집</span>
        </div>
        <div id="step-yt" class="hidden flex items-center gap-3 p-3 rounded-xl bg-gray-50 text-sm text-gray-500">
          <span id="step-yt-icon" class="text-base">○</span>
          <span id="step-yt-label">Phase 2.5 — YouTube 자막 수집 (브라우저)</span>
        </div>
        <div id="step-3" class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 text-sm text-gray-500">
          <span id="step-3-icon" class="text-base">○</span>
          <span>Phase 3 — Claude 포스트 생성</span>
        </div>
      </div>

      <!-- 결과 -->
      <div id="book-result" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl">
        <p class="text-sm font-semibold text-emerald-800 mb-2">포스트 생성 완료</p>
        <a id="book-result-link" href="#" target="_blank"
          class="text-sm text-sky-600 underline break-all"></a>
        <p id="book-result-cached" class="hidden mt-1 text-xs text-gray-400">이미 생성된 포스트입니다.</p>
      </div>

      <p id="book-error" class="hidden mt-3 text-sm text-red-500"></p>
      <p class="mt-3 text-xs text-gray-400">생성까지 약 40~60초 소요됩니다.</p>
    </div>

  </div>

  <!-- CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

  <script is:inline>
    // ── 탭 전환 ─────────────────────────────────────────────
    var TABS = ['qr', 'bar', 'book'];

    function switchTab(tab) {
      TABS.forEach(function(t) {
        document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);
        document.getElementById('tab-' + t).className =
          'tab-btn flex-1 py-2 text-sm font-semibold rounded-lg transition-all ' +
          (t === tab ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500');
      });
    }

    // ── 포스트 생성 ──────────────────────────────────────────
    var API = 'https://api.daparapara.com';

    function setStep(n, state, label) {
      // state: 'pending' | 'running' | 'done' | 'error'
      var el   = document.getElementById('step-' + n);
      var icon = document.getElementById('step-' + n + '-icon');
      var icons = { pending: '○', running: '⋯', done: '✓', error: '✗' };
      var colors = {
        pending: 'bg-gray-50 text-gray-400',
        running: 'bg-sky-50 text-sky-700',
        done:    'bg-emerald-50 text-emerald-700',
        error:   'bg-red-50 text-red-600',
      };
      el.classList.remove('hidden');
      el.className = 'flex items-center gap-3 p-3 rounded-xl text-sm ' + colors[state];
      icon.textContent = icons[state];
      if (label) document.getElementById('step-' + n + '-label').textContent = label;
    }

    // ── YouTube 자막 브라우저 직접 수집 ──────────────────────────
    // 브라우저는 실제 사용자 IP + YouTube 쿠키 → 서버 봇 감지 우회
    async function fetchTranscriptBrowser(videoId) {
      var endpoints = [
        'https://www.youtube.com/api/timedtext?v=' + videoId + '&lang=en&kind=asr&fmt=json3',
        'https://www.youtube.com/api/timedtext?v=' + videoId + '&lang=en&fmt=json3',
        'https://www.youtube.com/api/timedtext?v=' + videoId + '&lang=en&kind=asr',
        'https://www.youtube.com/api/timedtext?v=' + videoId + '&lang=en',
      ];
      for (var i = 0; i < endpoints.length; i++) {
        try {
          var res = await fetch(endpoints[i], { credentials: 'include' });
          if (!res.ok) continue;
          var text = await res.text();
          if (!text || text.length < 20) continue;

          var transcript = '';
          // JSON3 포맷
          if (text.trim().startsWith('{')) {
            var data = JSON.parse(text);
            transcript = (data.events || [])
              .filter(function(e) { return e.segs; })
              .map(function(e) { return e.segs.map(function(s) { return s.utf8 || ''; }).join(''); })
              .join(' ').trim();
          // XML 포맷
          } else if (text.includes('<text')) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(text, 'text/xml');
            transcript = Array.from(doc.querySelectorAll('text'))
              .map(function(n) { return n.textContent; }).join(' ').trim();
          }
          if (transcript.length > 20) return transcript.slice(0, 10000);
        } catch (e) { /* 다음 시도 */ }
      }
      return null;
    }

    function setButtons(disabled) {
      document.getElementById('btn-generate').disabled = disabled;
      document.getElementById('btn-force').disabled    = disabled;
    }

    async function generatePost(force) {
      var isbn  = document.getElementById('book-isbn').value.trim().replace(/[-\s]/g, '');
      var errEl = document.getElementById('book-error');
      errEl.classList.add('hidden');
      document.getElementById('book-result').classList.add('hidden');

      if (!isbn || !/^\d{10,13}$/.test(isbn)) {
        errEl.textContent = 'ISBN은 10~13자리 숫자여야 합니다.';
        errEl.classList.remove('hidden');
        return;
      }

      setButtons(true);
      document.getElementById('book-progress').classList.remove('hidden');
      [1, 2, 3].forEach(function(n) { setStep(n, 'pending'); });
      document.getElementById('step-yt').classList.add('hidden');

      try {
        // Phase 1
        setStep(1, 'running');
        var r1 = await fetch(API + '/book-info?isbn=' + isbn);
        if (!r1.ok) throw new Error('Phase 1 실패: ' + (await r1.json()).error);
        setStep(1, 'done');

        // Phase 2
        setStep(2, 'running');
        var r2 = await fetch(API + '/book-english?isbn=' + isbn);
        if (!r2.ok) throw new Error('Phase 2 실패: ' + (await r2.json()).error);
        var p2 = await r2.json();
        setStep(2, 'done');

        // Phase 2.5 — transcript 없으면 브라우저에서 직접 수집
        if (!p2.youtube_transcript && p2.youtube_video_id) {
          setStep('yt', 'running', 'Phase 2.5 — YouTube 자막 수집 (브라우저)');
          var transcript = await fetchTranscriptBrowser(p2.youtube_video_id);
          if (transcript) {
            await fetch(API + '/book-english?isbn=' + isbn, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                youtube_video_id:  p2.youtube_video_id,
                youtube_transcript: transcript,
              }),
            });
            setStep('yt', 'done', 'Phase 2.5 — YouTube 자막 수집 완료 (' + transcript.length + '자)');
          } else {
            setStep('yt', 'error', 'Phase 2.5 — 자막 없음 (영상에 CC 자막이 없거나 접근 불가)');
            // T2/T3는 Phase 3에서 차단되지만, T1은 계속 진행 가능
          }
        }

        // Phase 3
        setStep(3, 'running');
        var url3 = API + '/book-generate?isbn=' + isbn + (force ? '&force=true' : '');
        var r3   = await fetch(url3, { method: 'POST' });
        if (!r3.ok) throw new Error('Phase 3 실패: ' + (await r3.json()).error);
        var data = await r3.json();
        setStep(3, 'done');

        // 결과
        var resultEl  = document.getElementById('book-result');
        var linkEl    = document.getElementById('book-result-link');
        var cachedEl  = document.getElementById('book-result-cached');
        linkEl.href        = data.post_url;
        linkEl.textContent = data.post_url;
        cachedEl.classList.toggle('hidden', !data.cached);
        resultEl.classList.remove('hidden');

      } catch (e) {
        var failStep = [1,2,3].find(function(n) {
          return document.getElementById('step-' + n + '-icon').textContent === '⋯';
        });
        if (failStep) setStep(failStep, 'error');
        errEl.textContent = e.message;
        errEl.classList.remove('hidden');
      } finally {
        setButtons(false);
      }
    }

    // ── QR 생성 ─────────────────────────────────────────────
    var _qrObj = null;

    function generateQr() {
      var text    = document.getElementById('qr-input').value.trim();
      var size    = parseInt(document.getElementById('qr-size').value);
      var ec      = document.getElementById('qr-ec').value;
      var errEl   = document.getElementById('qr-error');
      var resultEl = document.getElementById('qr-result');

      errEl.classList.add('hidden');
      if (!text) {
        errEl.textContent = '내용을 입력해주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      var wrap = document.getElementById('qr-canvas-wrap');
      wrap.innerHTML = '';

      try {
        _qrObj = new QRCode(wrap, {
          text: text,
          width: size,
          height: size,
          correctLevel: QRCode.CorrectLevel[ec],
        });
        resultEl.classList.remove('hidden');
      } catch (e) {
        errEl.textContent = '생성 실패: 내용이 너무 길거나 지원하지 않는 형식입니다.';
        errEl.classList.remove('hidden');
      }
    }

    function downloadQr() {
      var canvas = document.querySelector('#qr-canvas-wrap canvas');
      if (!canvas) return;
      var a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'qrcode.png';
      a.click();
    }

    // ── 바코드 생성 ──────────────────────────────────────────
    function generateBar() {
      var text     = document.getElementById('bar-input').value.trim().replace(/[-\s]/g, '');
      var format   = document.getElementById('bar-format').value;
      var showText = document.getElementById('bar-label').value === '1';
      var errEl    = document.getElementById('bar-error');
      var resultEl = document.getElementById('bar-result');

      errEl.classList.add('hidden');
      resultEl.classList.add('hidden');

      if (!text) {
        errEl.textContent = '내용을 입력해주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      try {
        JsBarcode('#bar-svg', text, {
          format: format,
          displayValue: showText,
          fontSize: 14,
          margin: 10,
          background: '#ffffff',
          lineColor: '#000000',
        });
        resultEl.classList.remove('hidden');
      } catch (e) {
        errEl.textContent = '생성 실패: 입력값이 ' + format + ' 형식에 맞지 않습니다.';
        errEl.classList.remove('hidden');
      }
    }

    function downloadBar() {
      var svg = document.getElementById('bar-svg');
      if (!svg) return;

      var svgData  = new XMLSerializer().serializeToString(svg);
      var canvas   = document.createElement('canvas');
      var bbox     = svg.getBoundingClientRect();
      canvas.width  = svg.width ? svg.width.baseVal.value : bbox.width;
      canvas.height = svg.height ? svg.height.baseVal.value : bbox.height;

      var img = new Image();
      img.onload = function() {
        canvas.getContext('2d').drawImage(img, 0, 0);
        var a = document.createElement('a');
        a.href = canvas.toDataURL('image/png');
        a.download = 'barcode.png';
        a.click();
      };
      img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
    }

    // URL 파라미터로 초기 탭 선택 (?tab=book 등)
    (function() {
      var tab = new URLSearchParams(window.location.search).get('tab');
      if (tab && TABS.includes(tab)) switchTab(tab);
    })();

    // 엔터키 지원
    document.getElementById('qr-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') generateQr();
    });
    document.getElementById('bar-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') generateBar();
    });
    document.getElementById('book-isbn').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') generatePost(false);
    });
  </script>
</BaseLayout>
