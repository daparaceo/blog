---
// src/pages/tools.astro
// QR코드 · 바코드 생성기 + 영어원서 포스트 관리 — 사이트맵 미노출, /tools 직접 접근
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('learn', ({ data }) => !data.draft);
const isbnPostMap: Record<string, { slug: string; title: string; ogImage: string }> = {};
for (const post of posts) {
  const addEntry = (isbn: string) => {
    const clean = isbn.replace(/\D/g, '');
    if (clean.length >= 10 && !isbnPostMap[clean]) {
      isbnPostMap[clean] = {
        slug:    post.slug.includes('/') ? post.slug.split('/').pop()! : post.slug,
        title:   post.data.title,
        ogImage: post.data.ogImage ?? '',
      };
    }
  };
  if (post.data.isbn) addEntry(String(post.data.isbn));
  const filename = post.slug.split('/').pop() ?? '';
  const m = filename.match(/_(97[89]\d{10})$/);
  if (m) addEntry(m[1]);
}
---

<BaseLayout title="QR · 바코드 생성기" description="QR코드와 바코드를 무료로 생성하고 다운로드하세요.">
  <div class="max-w-xl mx-auto px-4 py-8">

    <h1 class="text-2xl font-bold text-gray-900 mb-6">Tools</h1>

    <!-- 탭 -->
    <div class="flex gap-1 bg-gray-100 p-1 rounded-xl mb-6">
      <button id="tab-qr"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-gray-900 shadow-sm transition-all"
        onclick="switchTab('qr')">QR 코드 생성</button>
      <button id="tab-bar"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg text-gray-500 transition-all"
        onclick="switchTab('bar')">바코드 생성</button>
      <button id="tab-book"
        class="tab-btn flex-1 py-2 text-sm font-semibold rounded-lg text-gray-500 transition-all"
        onclick="switchTab('book')">영어원서 포스트 생성</button>
    </div>

    <!-- ── QR 코드 패널 ─────────────────────────────────── -->
    <div id="panel-qr">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">내용 (URL 또는 텍스트)</label>
          <input id="qr-input" type="text" placeholder="https://daparapara.com"
            class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">크기</label>
            <select id="qr-size"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="128">128 px</option>
              <option value="256" selected>256 px</option>
              <option value="512">512 px</option>
            </select>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">오류 복원</label>
            <select id="qr-ec"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="L">낮음 (L)</option>
              <option value="M" selected>보통 (M)</option>
              <option value="Q">높음 (Q)</option>
              <option value="H">최고 (H)</option>
            </select>
          </div>
        </div>

        <button onclick="generateQr()"
          class="w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">
          생성하기
        </button>
      </div>

      <div id="qr-result" class="hidden mt-6 text-center">
        <div class="inline-block bg-white border border-gray-200 rounded-2xl p-4 shadow-sm">
          <div id="qr-canvas-wrap"></div>
        </div>
        <div class="mt-4">
          <button onclick="downloadQr()"
            class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 active:scale-95 transition-all">
            PNG 다운로드
          </button>
        </div>
      </div>

      <p id="qr-error" class="hidden mt-3 text-sm text-red-500 text-center"></p>
    </div>

    <!-- ── 바코드 패널 ──────────────────────────────────── -->
    <div id="panel-bar" class="hidden">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">내용</label>
          <input id="bar-input" type="text" placeholder="978-89-12345-00-3"
            class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">형식</label>
            <select id="bar-format"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="CODE128">CODE 128 (일반)</option>
              <option value="EAN13">EAN-13 (ISBN)</option>
              <option value="EAN8">EAN-8</option>
              <option value="UPCA">UPC-A</option>
              <option value="CODE39">CODE 39</option>
            </select>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">텍스트 표시</label>
            <select id="bar-label"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 bg-white">
              <option value="1" selected>표시</option>
              <option value="0">숨김</option>
            </select>
          </div>
        </div>

        <button onclick="generateBar()"
          class="w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">
          생성하기
        </button>
      </div>

      <div id="bar-result" class="hidden mt-6 text-center">
        <div class="inline-block bg-white border border-gray-200 rounded-2xl p-4 shadow-sm overflow-x-auto max-w-full">
          <svg id="bar-svg"></svg>
        </div>
        <div class="mt-4">
          <button onclick="downloadBar()"
            class="px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 active:scale-95 transition-all">
            PNG 다운로드
          </button>
        </div>
      </div>

      <p id="bar-error" class="hidden mt-3 text-sm text-red-500 text-center"></p>
    </div>

    <!-- ── 포스트 생성 패널 ───────────────────────────────── -->
    <div id="panel-book" class="hidden">

      <!-- 제목/저자 검색 -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">제목, 저자 또는 ISBN</label>
        <div class="flex gap-2">
          <button id="scan-open-btn" onclick="openScanner()"
            class="md:hidden flex-shrink-0 flex items-center justify-center w-10 bg-gray-100 text-gray-600 rounded-xl hover:bg-gray-200 active:scale-95 transition-all">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <rect x="2"   y="4" width="1.5" height="16"/>
              <rect x="4.5" y="4" width="1"   height="16"/>
              <rect x="6.5" y="4" width="2"   height="16"/>
              <rect x="9.5" y="4" width="1"   height="16"/>
              <rect x="11.5" y="4" width="1.5" height="16"/>
              <rect x="14"  y="4" width="1"   height="16"/>
              <rect x="16"  y="4" width="2"   height="16"/>
              <rect x="19"  y="4" width="1"   height="16"/>
              <rect x="21"  y="4" width="1.5" height="16"/>
            </svg>
          </button>
          <input id="book-query" type="text" placeholder="Harry Potter / J.K. Rowling / 9780439708180"
            class="flex-1 px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
          <button onclick="searchByTitle(false)"
            class="px-4 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-xl hover:bg-gray-200 active:scale-95 transition-all">
            검색
          </button>
        </div>
        <div id="book-candidates" class="hidden mt-2 space-y-2"></div>
        <button id="btn-more-search"
          class="hidden mt-2 w-full py-2 text-sm text-sky-600 border border-sky-200 rounded-xl hover:bg-sky-50 transition-colors"
          onclick="searchByTitle(true)">
          추가 검색
        </button>
      </div>

      <input id="book-isbn" type="hidden" />

      <!-- 인라인 스캐너 -->
      <div id="book-scanner-wrap" class="hidden mt-3">
        <div class="relative bg-gray-900 rounded-2xl overflow-hidden" style="aspect-ratio: 4/3;">
          <div id="book-qr-reader" class="absolute inset-0 w-full h-full"></div>
          <div id="book-start-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-4">
            <svg class="w-10 h-10 text-gray-600" viewBox="0 0 48 48" fill="currentColor">
              <rect x="4"  y="10" width="3"  height="28"/>
              <rect x="9"  y="10" width="2"  height="28"/>
              <rect x="13" y="10" width="4"  height="28"/>
              <rect x="19" y="10" width="2"  height="28"/>
              <rect x="23" y="10" width="3"  height="28"/>
              <rect x="28" y="10" width="2"  height="28"/>
              <rect x="32" y="10" width="4"  height="28"/>
              <rect x="38" y="10" width="2"  height="28"/>
              <rect x="42" y="10" width="3"  height="28"/>
            </svg>
            <button onclick="startBookScanner()"
              class="px-6 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all shadow-lg">
              카메라 시작
            </button>
            <p class="text-xs text-gray-500 text-center px-4">카메라 권한 요청 시 허용을 눌러주세요</p>
          </div>
          <div id="book-scan-guide" class="hidden absolute inset-0 pointer-events-none">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="relative w-4/5" style="height:80px">
                <div class="absolute inset-0 border border-sky-400/60 rounded"></div>
                <div class="absolute -top-px -left-px w-6 h-6 border-t-2 border-l-2 border-sky-400 rounded-tl-sm"></div>
                <div class="absolute -top-px -right-px w-6 h-6 border-t-2 border-r-2 border-sky-400 rounded-tr-sm"></div>
                <div class="absolute -bottom-px -left-px w-6 h-6 border-b-2 border-l-2 border-sky-400 rounded-bl-sm"></div>
                <div class="absolute -bottom-px -right-px w-6 h-6 border-b-2 border-r-2 border-sky-400 rounded-br-sm"></div>
                <div id="book-scan-line" class="absolute left-1 right-1 h-px bg-sky-400"></div>
              </div>
            </div>
            <p class="absolute bottom-3 left-0 right-0 text-center text-white/70 text-xs">
              책 뒷면 바코드를 박스 안에 맞춰주세요
            </p>
          </div>
        </div>
        <p id="book-scan-status" class="hidden mt-2 text-sm text-center text-gray-500"></p>
        <button onclick="closeScanner()"
          class="mt-2 w-full py-2 text-sm text-gray-500 border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors">
          닫기
        </button>
      </div>

      <!-- 책 정보 카드 (ISBN 확정 후 표시) -->
      <div id="book-info-card" class="hidden mt-4"></div>

      <!-- 포스트 생성 진행 상태 -->
      <div id="book-post-progress" class="hidden mt-4">
        <div class="flex items-center gap-3 p-4 bg-sky-50 border border-sky-200 rounded-xl">
          <div class="w-4 h-4 border-2 border-sky-600 border-t-transparent rounded-full animate-spin flex-shrink-0"></div>
          <p class="text-sm text-sky-700">워크봇이 포스트를 생성 중입니다...</p>
        </div>
        <p id="book-poll-elapsed" class="mt-2 text-xs text-gray-400 text-center"></p>
      </div>

      <!-- 포스트 생성 완료 -->
      <div id="book-post-result" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl">
        <p class="text-sm font-semibold text-emerald-800">포스트 생성 완료</p>
        <p class="text-xs text-emerald-600 mt-1">블로그에서 확인해주세요.</p>
      </div>

      <p id="book-error" class="hidden mt-3 text-sm text-red-500"></p>
    </div>

  </div>

  <!-- CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
  <script is:inline src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <script is:inline define:vars={{ isbnPostMap }}>
    window.__ISBN_MAP__ = isbnPostMap;
  </script>

  <script is:inline>
    // ── 탭 전환 ─────────────────────────────────────────────
    var TABS = ['qr', 'bar', 'book'];

    function switchTab(tab) {
      TABS.forEach(function(t) {
        document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);
        document.getElementById('tab-' + t).className =
          'tab-btn flex-1 py-2 text-sm font-semibold rounded-lg transition-all ' +
          (t === tab ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500');
      });
    }

    // ── ISBN 스캐너 ──────────────────────────────────────────
    var _bookQrCode = null;
    var _bookScanning = false;

    function normalizeIsbn(raw) {
      var d = raw.replace(/\D/g, '');
      if (d.length === 13 && /^97[89]/.test(d)) return d;
      if (d.length === 14 && /^97[89]/.test(d)) {
        var b12 = d.slice(0, 12), s = 0;
        for (var i = 0; i < 12; i++) s += parseInt(b12[i]) * (i % 2 === 0 ? 1 : 3);
        return b12 + ((10 - s % 10) % 10);
      }
      if (d.length === 15 && /^97[89]/.test(d)) return d.slice(0, 13);
      if (d.length === 10) {
        var base = '978' + d.slice(0, 9), s2 = 0;
        for (var j = 0; j < 12; j++) s2 += parseInt(base[j]) * (j % 2 === 0 ? 1 : 3);
        return base + ((10 - s2 % 10) % 10);
      }
      return d;
    }

    function openScanner() {
      document.getElementById('book-scanner-wrap').classList.remove('hidden');
      document.getElementById('book-scanner-wrap').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeScanner() {
      document.getElementById('book-scanner-wrap').classList.add('hidden');
      document.getElementById('book-scan-guide').classList.add('hidden');
      document.getElementById('book-start-overlay').classList.remove('hidden');
      document.getElementById('book-scan-status').classList.add('hidden');
      if (_bookQrCode) {
        _bookQrCode.stop().catch(function() {});
        _bookQrCode = null;
      }
      _bookScanning = false;
    }

    async function startBookScanner() {
      if (_bookScanning) return;
      var startOverlay = document.getElementById('book-start-overlay');
      var scanGuide    = document.getElementById('book-scan-guide');
      var statusEl     = document.getElementById('book-scan-status');

      startOverlay.classList.add('hidden');
      statusEl.textContent = '카메라 초기화 중...';
      statusEl.className = 'mt-2 text-sm text-center text-gray-500';
      statusEl.classList.remove('hidden');

      try {
        _bookQrCode = new Html5Qrcode('book-qr-reader');
        await _bookQrCode.start(
          { facingMode: 'environment' },
          {
            fps: 10,
            qrbox: { width: 260, height: 90 },
            formatsToSupport: [
              Html5QrcodeSupportedFormats.EAN_13,
              Html5QrcodeSupportedFormats.EAN_8,
            ],
            useBarCodeDetectorIfSupported: true,
          },
          function(decodedText) {
            if (!_bookScanning) return;
            _bookScanning = false;
            _bookQrCode.stop().catch(function() {});
            var isbn = normalizeIsbn(decodedText);
            document.getElementById('book-isbn').value = isbn;
            if (navigator.vibrate) navigator.vibrate(120);
            closeScanner();
            lookupIsbn();
          },
          function() {}
        );
        _bookScanning = true;
        statusEl.classList.add('hidden');
        scanGuide.classList.remove('hidden');
        startBookScanLine();
      } catch (err) {
        startOverlay.classList.remove('hidden');
        var msg;
        if (err && (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError')) {
          msg = '카메라 권한이 거부되었습니다. 주소창 자물쇠 아이콘에서 권한을 허용해주세요.';
        } else if (err && (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError')) {
          msg = '카메라를 찾을 수 없습니다.';
        } else {
          msg = '카메라를 시작할 수 없습니다. 브라우저 설정을 확인해주세요.';
        }
        statusEl.textContent = msg;
        statusEl.className = 'mt-2 text-sm text-center text-red-500';
        statusEl.classList.remove('hidden');
      }
    }

    function startBookScanLine() {
      var line = document.getElementById('book-scan-line');
      if (!line) return;
      var dir = 1, pos = 4;
      (function animate() {
        if (!_bookScanning) return;
        pos += dir * 2;
        if (pos >= 74) dir = -1;
        if (pos <= 4)  dir =  1;
        line.style.top = pos + 'px';
        requestAnimationFrame(animate);
      })();
    }

    // ── 영어원서 탭 ──────────────────────────────────────────
    var API          = 'https://api.daparapara.com';
    var ISBN_MAP     = window.__ISBN_MAP__ || {};
    var _currentIsbn = null;
    var _pollTimer   = null;
    var _lastQuery   = '';
    var _lastPage    = 0;
    var _shownIsbns  = new Set();

    // ── AR 레벨 배지 ─────────────────────────────────────────
    function arBadgeHtml(ar) {
      if (!ar) return '';
      var n = parseFloat(ar);
      var cls = isNaN(n) ? 'bg-gray-100 text-gray-600'
               : n < 1.0 ? 'bg-purple-100 text-purple-700'
               : n < 3.5 ? 'bg-sky-100 text-sky-700'
               :            'bg-amber-100 text-amber-700';
      return '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ' +
             cls + '">AR ' + ar + '</span>';
    }

    // ── 제목/저자 검색 ────────────────────────────────────────
    async function searchByTitle(extended) {
      var q = document.getElementById('book-query').value.trim();
      if (!q || q.length < 2) return;

      var digits = q.replace(/\D/g, '');
      if (digits.length === 10 || digits.length === 13) {
        document.getElementById('book-isbn').value = digits;
        lookupIsbn();
        return;
      }

      _lastQuery = q;
      var size = 5;

      if (!extended) {
        _lastPage = 0;
        _shownIsbns.clear();
      } else {
        _lastPage++;
      }

      var listEl    = document.getElementById('book-candidates');
      var moreBtn   = document.getElementById('btn-more-search');
      var errEl     = document.getElementById('book-error');
      errEl.classList.add('hidden');
      moreBtn.classList.add('hidden');

      if (!extended) {
        listEl.innerHTML = '<p class="text-sm text-center text-gray-400 py-3">검색 중...</p>';
        listEl.classList.remove('hidden');
      } else {
        listEl.insertAdjacentHTML('beforeend',
          '<p id="more-loading" class="text-sm text-center text-gray-400 py-3">검색 중...</p>');
      }

      try {
        var res = await fetch(
          API + '/book-search?q=' + encodeURIComponent(q) +
          '&size=' + size + '&lang=en&page=' + _lastPage
        );
        if (!res.ok) throw new Error('검색 실패 (' + res.status + ')');
        var data = await res.json();
        var results = data.results || [];

        var loadingEl = document.getElementById('more-loading');
        if (loadingEl) loadingEl.remove();

        if (!results.length) {
          if (!extended) {
            listEl.innerHTML = '<p class="text-sm text-center text-gray-500 py-3">결과가 없어요. 영어로 검색해보세요.</p>';
          } else {
            listEl.insertAdjacentHTML('beforeend',
              '<p class="text-sm text-center text-gray-500 py-3">더 이상 결과가 없어요.</p>');
          }
          return;
        }

        var filtered = results.filter(function(item) {
          if (_shownIsbns.has(item.isbn)) return false;
          _shownIsbns.add(item.isbn);
          return true;
        });
        var html = filtered.map(function(item) {
          return '<button type="button" ' +
            'class="w-full text-left bg-white border border-gray-200 rounded-xl p-3 ' +
            'hover:border-sky-300 hover:bg-sky-50 active:scale-[0.98] transition-all" ' +
            'onclick="selectCandidate(' + JSON.stringify(item).replace(/"/g, '&quot;') + ')">' +
            '<div class="flex items-start gap-3">' +
            (item.cover_url
              ? '<img src="' + item.cover_url + '" class="w-10 h-14 object-cover rounded flex-shrink-0" onerror="this.style.display=\'none\'">'
              : '') +
            '<div class="flex-1 min-w-0">' +
            '<p class="text-sm font-semibold text-gray-900 leading-snug line-clamp-2">' + (item.title || '(제목 없음)') + '</p>' +
            (item.author ? '<p class="text-xs text-gray-500 mt-0.5">' + item.author + '</p>' : '') +
            (item.ar_level ? '<div class="mt-1">' + arBadgeHtml(item.ar_level) + '</div>' : '') +
            '</div></div></button>';
        }).join('');

        if (!extended) {
          listEl.innerHTML = html;
        } else {
          if (html) {
            listEl.insertAdjacentHTML('beforeend', html);
          } else {
            listEl.insertAdjacentHTML('beforeend',
              '<p class="text-sm text-center text-gray-500 py-3">더 이상 새로운 결과가 없어요.</p>');
          }
        }

        moreBtn.classList.toggle('hidden', filtered.length === 0 || results.length < size);
      } catch (e) {
        var loadingEl = document.getElementById('more-loading');
        if (loadingEl) loadingEl.remove();
        if (!extended) {
          listEl.innerHTML = '<p class="text-sm text-center text-red-400 py-3">검색 오류: ' + e.message + '</p>';
        } else {
          listEl.insertAdjacentHTML('beforeend',
            '<p class="text-sm text-center text-red-400 py-3">검색 오류: ' + e.message + '</p>');
        }
      }
    }

    function selectCandidate(item) {
      document.getElementById('book-candidates').classList.add('hidden');
      document.getElementById('btn-more-search').classList.add('hidden');
      if (!item.isbn) return;

      var cleanIsbn = item.isbn.replace(/\D/g, '');
      _currentIsbn = cleanIsbn;
      document.getElementById('book-isbn').value = cleanIsbn;
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

      var post    = ISBN_MAP[cleanIsbn] || ISBN_MAP[item.isbn];
      var arHtml  = arBadgeHtml(item.ar_level);
      var ctaHtml = post
        ? '<a href="/learn/english/books/' + post.slug + '/" target="_blank" ' +
          'class="inline-block mt-3 px-4 py-1.5 bg-emerald-600 text-white text-xs font-semibold ' +
          'rounded-lg hover:bg-emerald-700 active:scale-95 transition-all">포스트 보기</a>'
        : '<button onclick="startPostPolling()" ' +
          'class="mt-3 w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl ' +
          'hover:bg-sky-700 active:scale-95 transition-all">포스트 생성하기</button>';

      var cardEl = document.getElementById('book-info-card');
      document.getElementById('book-post-progress').classList.add('hidden');
      document.getElementById('book-post-result').classList.add('hidden');
      document.getElementById('book-error').classList.add('hidden');
      cardEl.innerHTML =
        '<div class="p-4 bg-white border border-gray-200 rounded-xl">' +
        '<div class="flex gap-3">' +
        (item.cover_url
          ? '<img src="' + item.cover_url + '" alt="표지" ' +
            'class="w-14 h-20 object-cover rounded-lg shadow-sm flex-shrink-0" ' +
            'onerror="this.style.display=\'none\'">'
          : '') +
        '<div class="flex-1 min-w-0">' +
        (post ? '<p class="text-xs font-semibold text-emerald-600 mb-0.5">포스트 있음</p>' : '') +
        '<p class="font-semibold text-gray-900 text-sm leading-snug">' + (item.title || '') + '</p>' +
        (item.author ? '<p class="text-xs text-gray-500 mt-0.5">' + item.author + '</p>' : '') +
        (arHtml ? '<div class="mt-1">' + arHtml + '</div>' : '') +
        '</div></div>' +
        ctaHtml +
        '</div>';
      cardEl.classList.remove('hidden');
    }

    // ── ISBN 확정 → 책 정보 조회 ─────────────────────────────
    async function lookupIsbn() {
      var isbn  = document.getElementById('book-isbn').value.trim().replace(/\D/g, '');
      var errEl = document.getElementById('book-error');
      var cardEl = document.getElementById('book-info-card');

      errEl.classList.add('hidden');
      cardEl.classList.add('hidden');
      document.getElementById('book-post-progress').classList.add('hidden');
      document.getElementById('book-post-result').classList.add('hidden');
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

      if (!isbn || !/^\d{10,13}$/.test(isbn)) {
        errEl.textContent = 'ISBN은 10~13자리 숫자여야 합니다.';
        errEl.classList.remove('hidden');
        return;
      }

      _currentIsbn = null;
      cardEl.innerHTML = '<div class="p-4 bg-gray-50 rounded-xl text-sm text-gray-400 text-center">도서 정보 조회 중...</div>';
      cardEl.classList.remove('hidden');

      try {
        var res  = await fetch(API + '/book-search?isbn=' + isbn);
        if (!res.ok) {
          var body = await res.json().catch(function() { return {}; });
          throw new Error(body.error || '도서 정보를 찾을 수 없습니다.');
        }
        var book = await res.json();
        _currentIsbn = book.isbn || isbn;
        cardEl.innerHTML = buildBookCard(book);
        cardEl.classList.remove('hidden');
      } catch (e) {
        cardEl.classList.add('hidden');
        errEl.textContent = e.message;
        errEl.classList.remove('hidden');
      }
    }

    // ── 책 정보 카드 렌더 ─────────────────────────────────────
    function buildBookCard(book) {
      var post    = ISBN_MAP[book.isbn] || ISBN_MAP[(book.isbn || '').replace(/\D/g, '')];
      var arHtml  = arBadgeHtml(book.ar_level);
      var ctaHtml = post
        ? '<a href="/blog/' + post.slug + '/" target="_blank" ' +
          'class="inline-block mt-3 px-4 py-1.5 bg-emerald-600 text-white text-xs font-semibold rounded-lg hover:bg-emerald-700 active:scale-95 transition-all">' +
          '리뷰 보기</a>'
        : '<button onclick="startPostPolling()" ' +
          'class="mt-3 w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">' +
          '포스트 생성하기</button>';

      return '<div class="p-4 bg-white border border-gray-200 rounded-xl">' +
        '<div class="flex gap-3">' +
        (book.cover
          ? '<img src="' + book.cover + '" alt="표지" class="w-14 h-20 object-cover rounded-lg shadow-sm flex-shrink-0" onerror="this.style.display=\'none\'">'
          : '') +
        '<div class="flex-1 min-w-0">' +
        (post ? '<p class="text-xs font-semibold text-emerald-600 mb-0.5">리뷰 있음</p>' : '') +
        '<p class="font-semibold text-gray-900 text-sm leading-snug">' + (book.title || '') + '</p>' +
        (book.author ? '<p class="text-xs text-gray-500 mt-0.5">' + book.author + '</p>' : '') +
        (book.series ? '<p class="text-xs text-gray-400 mt-0.5">' + book.series + '</p>' : '') +
        (arHtml ? '<div class="mt-1">' + arHtml + '</div>' : '') +
        '</div></div>' +
        ctaHtml +
        '</div>';
    }

    // ── 포스트 생성 폴링 ─────────────────────────────────────
    var POLL_INTERVAL = 10000;
    var POLL_TIMEOUT  = 180000;

    function startPostPolling() {
      if (!_currentIsbn) return;
      document.getElementById('book-post-progress').classList.remove('hidden');
      document.getElementById('book-post-result').classList.add('hidden');
      document.getElementById('book-error').classList.add('hidden');

      var deadline = Date.now() + POLL_TIMEOUT;

      _pollTimer = setInterval(async function() {
        try {
          var elapsed = Math.round((Date.now() - (deadline - POLL_TIMEOUT)) / 1000);
          document.getElementById('book-poll-elapsed').textContent = elapsed + '초 경과';

          var res  = await fetch(API + '/book-status?isbn=' + _currentIsbn);
          var data = await res.json();

          if (data.status === 'completed') {
            clearInterval(_pollTimer); _pollTimer = null;
            document.getElementById('book-post-progress').classList.add('hidden');
            document.getElementById('book-post-result').classList.remove('hidden');
          } else if (Date.now() >= deadline) {
            clearInterval(_pollTimer); _pollTimer = null;
            document.getElementById('book-post-progress').classList.add('hidden');
            var errEl = document.getElementById('book-error');
            errEl.textContent = '포스트 생성에 실패했습니다. 워크봇 상태를 확인해주세요.';
            errEl.classList.remove('hidden');
          }
        } catch (_) {}
      }, POLL_INTERVAL);
    }

    // ── QR 생성 ─────────────────────────────────────────────
    var _qrObj = null;

    function generateQr() {
      var text    = document.getElementById('qr-input').value.trim();
      var size    = parseInt(document.getElementById('qr-size').value);
      var ec      = document.getElementById('qr-ec').value;
      var errEl   = document.getElementById('qr-error');
      var resultEl = document.getElementById('qr-result');

      errEl.classList.add('hidden');
      if (!text) {
        errEl.textContent = '내용을 입력해주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      var wrap = document.getElementById('qr-canvas-wrap');
      wrap.innerHTML = '';

      try {
        _qrObj = new QRCode(wrap, {
          text: text,
          width: size,
          height: size,
          correctLevel: QRCode.CorrectLevel[ec],
        });
        resultEl.classList.remove('hidden');
      } catch (e) {
        errEl.textContent = '생성 실패: 내용이 너무 길거나 지원하지 않는 형식입니다.';
        errEl.classList.remove('hidden');
      }
    }

    function downloadQr() {
      var canvas = document.querySelector('#qr-canvas-wrap canvas');
      if (!canvas) return;
      var a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'qrcode.png';
      a.click();
    }

    // ── 바코드 생성 ──────────────────────────────────────────
    function generateBar() {
      var text     = document.getElementById('bar-input').value.trim().replace(/[-\s]/g, '');
      var format   = document.getElementById('bar-format').value;
      var showText = document.getElementById('bar-label').value === '1';
      var errEl    = document.getElementById('bar-error');
      var resultEl = document.getElementById('bar-result');

      errEl.classList.add('hidden');
      resultEl.classList.add('hidden');

      if (!text) {
        errEl.textContent = '내용을 입력해주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      try {
        JsBarcode('#bar-svg', text, {
          format: format,
          displayValue: showText,
          fontSize: 14,
          margin: 10,
          background: '#ffffff',
          lineColor: '#000000',
        });
        resultEl.classList.remove('hidden');
      } catch (e) {
        errEl.textContent = '생성 실패: 입력값이 ' + format + ' 형식에 맞지 않습니다.';
        errEl.classList.remove('hidden');
      }
    }

    function downloadBar() {
      var svg = document.getElementById('bar-svg');
      if (!svg) return;

      var svgData  = new XMLSerializer().serializeToString(svg);
      var canvas   = document.createElement('canvas');
      var bbox     = svg.getBoundingClientRect();
      canvas.width  = svg.width ? svg.width.baseVal.value : bbox.width;
      canvas.height = svg.height ? svg.height.baseVal.value : bbox.height;

      var img = new Image();
      img.onload = function() {
        canvas.getContext('2d').drawImage(img, 0, 0);
        var a = document.createElement('a');
        a.href = canvas.toDataURL('image/png');
        a.download = 'barcode.png';
        a.click();
      };
      img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
    }

    // URL 파라미터로 초기 탭 선택 (?tab=book 등)
    (function() {
      var tab = new URLSearchParams(window.location.search).get('tab');
      if (tab && TABS.includes(tab)) switchTab(tab);
    })();

    // 엔터키 지원
    document.getElementById('qr-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') generateQr();
    });
    document.getElementById('bar-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') generateBar();
    });
    document.getElementById('book-isbn').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') lookupIsbn();
    });
    document.getElementById('book-query').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') searchByTitle(false);
    });
  </script>
  <style is:inline>
    #book-qr-reader                  { border: none !important; padding: 0 !important; background: transparent !important; }
    #book-qr-reader video            { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; position: absolute !important; inset: 0 !important; }
    #book-qr-reader__dashboard       { display: none !important; }
    #book-qr-reader__status_span     { display: none !important; }
    #book-qr-reader__scan_region     { background: transparent !important; border: none !important; }
    #book-qr-reader__scan_region img { display: none !important; }
  </style>
</BaseLayout>
