---
const targetUrl = 'https://link.coupang.com/a/bNsh5C';
const title = '쿠팡 바로가기';
const description = '쿠팡 추천 링크를 앱처럼 빠르게 엽니다.';
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0ea5e9" />
  <link rel="canonical" href="https://daparapara.com/go/coupang/" />
  <link rel="manifest" href="/manifest-coupang.json" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="쿠팡" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <style>
    :root {
      color-scheme: light;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f8fafc;
      color: #111827;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    main {
      width: min(100%, 420px);
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #ffffff;
      padding: 24px;
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    }

    img {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      display: block;
    }

    h1 {
      margin: 18px 0 8px;
      font-size: 24px;
      line-height: 1.25;
      letter-spacing: 0;
    }

    p {
      margin: 0;
      color: #4b5563;
      font-size: 15px;
      line-height: 1.7;
    }

    .actions {
      display: grid;
      gap: 10px;
      margin-top: 22px;
    }

    button,
    a {
      width: 100%;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid transparent;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .primary {
      background: #0ea5e9;
      color: #ffffff;
    }

    .secondary {
      background: #ffffff;
      border-color: #d1d5db;
      color: #374151;
    }

    .hint {
      min-height: 22px;
      margin-top: 14px;
      color: #64748b;
      font-size: 13px;
    }

    .hidden {
      display: none;
    }
  </style>
</head>
<body>
  <main>
    <img src="/apple-touch-icon.png" alt="" />
    <h1>{title}</h1>
    <p id="message">앱으로 설치하면 앱 목록에서 바로 열 수 있습니다.</p>

    <div class="actions">
      <a class="primary" href={targetUrl} rel="nofollow sponsored">쿠팡 열기</a>
      <button id="install-button" class="secondary hidden" type="button">앱으로 설치</button>
    </div>

    <p id="hint" class="hint"></p>
  </main>

  <script define:vars={{ targetUrl }}>
    const installButton = document.getElementById('install-button');
    const message = document.getElementById('message');
    const hint = document.getElementById('hint');
    let deferredPrompt = null;

    function isStandalone() {
      return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    }

    function isMobileSafari() {
      const ua = window.navigator.userAgent;
      return /iPhone|iPad|iPod/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
    }

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/coupang-shortcut-sw.js', { scope: '/go/coupang/' }).catch(() => {});
    }

    if (isStandalone()) {
      message.textContent = '쿠팡으로 이동합니다.';
      window.setTimeout(() => {
        window.location.href = targetUrl;
      }, 350);
    }

    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      deferredPrompt = event;
      installButton.classList.remove('hidden');
      hint.textContent = '설치 후 앱 목록에서 쿠팡 바로가기를 실행할 수 있습니다.';
    });

    installButton.addEventListener('click', async () => {
      if (!deferredPrompt) {
        if (isMobileSafari()) {
          hint.textContent = 'Safari 공유 버튼을 누른 뒤 홈 화면에 추가를 선택하세요.';
        }
        return;
      }

      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      installButton.classList.add('hidden');
      hint.textContent = '설치가 끝나면 앱 목록에서 실행하세요.';
    });

    if (isMobileSafari() && !isStandalone()) {
      hint.textContent = 'iPhone은 Safari 공유 버튼의 홈 화면에 추가를 사용합니다.';
    }
  </script>
</body>
</html>
