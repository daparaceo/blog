---

<BaseLayout
  title="블랙야크 명산 100"
  description="블랙야크 명산100 챌린지 산 목록과 위치를 지도에서 확인하세요."
  noPadding={true}
>
  <Fragment set:html={`<script src="//dapi.kakao.com/v2/maps/sdk.js?appkey=${kakaoKey}"><\/script>`} slot="head" />
  <style is:global>
    html, body { overflow: hidden; height: 100%; }
  </style>

  <!-- 모바일 전용 헤더 (검색 + 필터 + 정렬) -->
  <div class="lg:hidden flex-shrink-0 bg-white border-b border-gray-200 px-4 pt-2 pb-2 shadow-sm">
    <div class="flex items-center justify-between mb-1.5">
      <h1 class="text-sm font-bold text-gray-800">블랙야크 명산100</h1>
      <span id="mountain-count-mob" class="text-xs text-gray-500"></span>
    </div>
    <div class="flex gap-2 mb-1.5">
      <input
        id="search-mob"
        type="text"
        placeholder="산 이름 검색..."
        class="flex-1 px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-sky-400"
      />
      <select id="sort-select-mob" class="text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:border-sky-400 bg-white text-gray-700 flex-shrink-0">
        <option value="name">이름순</option>
        <option value="height">높이순</option>
        <option value="distance">거리순</option>
      </select>
    </div>
    <div id="filter-chips-mob" class="flex gap-1.5 overflow-x-auto scrollbar-hide"></div>
  </div>

  <!-- 지도 + 목록 -->
  <div class="flex flex-col lg:flex-row flex-grow overflow-hidden">

    <!-- 지도 -->
    <div class="relative w-full lg:w-2/3 flex-shrink-0 h-[45dvh] lg:h-full lg:flex-shrink z-0">
      <div id="map" class="w-full h-full"></div>
    </div>

    <!-- 목록 패널 -->
    <div class="w-full lg:w-1/3 flex flex-col flex-1 border-t lg:border-t-0 lg:border-l border-gray-200 overflow-hidden">
      <!-- 헤더 (PC 전용) -->
      <div class="hidden lg:block px-4 pt-3 pb-2 bg-gray-50 border-b border-gray-200 flex-shrink-0">
        <div class="flex items-baseline justify-between">
          <h1 class="text-base font-bold text-gray-800">블랙야크 명산100</h1>
          <span id="mountain-count" class="text-xs text-gray-500"></span>
        </div>
        <div class="flex gap-2 mt-2">
          <input
            id="search"
            type="text"
            placeholder="산 이름 검색..."
            class="flex-1 px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-sky-400"
          />
          <select id="sort-select" class="text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:border-sky-400 bg-white text-gray-700 flex-shrink-0">
            <option value="name">이름순</option>
            <option value="height">높이순</option>
            <option value="distance">거리순</option>
          </select>
        </div>
        <div id="filter-chips" class="flex gap-1.5 overflow-x-auto py-2 scrollbar-hide"></div>
      </div>
      <div class="overflow-y-auto flex-1">
        <ul id="mountain-list" class="divide-y divide-gray-100"></ul>
        <footer class="lg:hidden border-t border-gray-200 px-4 py-6 text-center text-sm text-gray-500">
          <p>&copy; {new Date().getFullYear()} daparapara. All rights reserved.</p>
          <p class="mt-1 text-gray-400 text-xs">오래가는 가치를 만듭니다.</p>
          <p class="mt-2 text-xs">
            <a href="/privacy/" class="hover:text-sky-600 underline">개인정보처리방침</a>
            &nbsp;·&nbsp;
            <a href="/about/" class="hover:text-sky-600 underline">소개</a>
          </p>
        </footer>
      </div>
    </div>
  </div>

  <!-- 툴팁 -->
  <div id="tooltip" class="fixed z-50 hidden bg-white rounded-xl shadow-lg border border-gray-100 p-3 w-52 pointer-events-auto">
    <div class="flex items-start justify-between gap-1 mb-1">
      <span id="tt-name" class="text-sm font-semibold text-gray-900 leading-tight"></span>
      <button id="tt-close" class="flex-shrink-0 text-gray-400 hover:text-gray-600 text-base leading-none ml-1">✕</button>
    </div>
    <p id="tt-addr" class="text-[11px] text-gray-400 mb-1.5"></p>
    <p id="tt-height" class="text-xs text-sky-600 font-medium mb-2"></p>
    <div class="flex items-center gap-1.5">
      <span class="text-[10px] text-gray-400 mr-auto">지도 앱</span>
      <button id="tt-naver" class="w-7 h-7 rounded-lg overflow-hidden hover:opacity-80 flex-shrink-0" title="네이버 지도"><img src="https://www.google.com/s2/favicons?domain=map.naver.com&sz=64" class="w-full h-full object-cover" alt="네이버지도" /></button>
      <button id="tt-kakao" class="w-7 h-7 rounded-lg overflow-hidden hover:opacity-80 flex-shrink-0" title="카카오맵"><img src="https://www.google.com/s2/favicons?domain=map.kakao.com&sz=64" class="w-full h-full object-cover" alt="카카오맵" /></button>
      <button id="tt-google" class="w-7 h-7 rounded-lg overflow-hidden hover:opacity-80 flex-shrink-0" title="구글 지도"><img src="https://www.google.com/s2/favicons?domain=maps.google.com&sz=64" class="w-full h-full object-cover" alt="구글지도" /></button>
    </div>
  </div>

  <Fragment set:html={`<script>window.__M__=${mountainsJson};window.__KK__='${kakaoKey}';<\/script>`} />
  <script is:inline>
  (function() {
    var mountains = window.__M__;
    var map = null;
    var markers = [];
    var selectMarkerFn = null;
    var selectedIdx = null;
    var myMarker = null;
    var tooltip = document.getElementById('tooltip');
    var userLat = null;
    var userLng = null;
    var currentFilter = '전체';
    var currentSort = 'name';

    var NAMSAN_LAT = 37.5512;
    var NAMSAN_LNG = 126.9882;

    function extractCity(addr) {
      var parts = addr.split(/\s+/);
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        if (/[시군]$/.test(p) && !/광역시$/.test(p) && !/특별시$/.test(p) && !/특별자치시$/.test(p)) {
          return p.replace(/[시군]$/, '');
        }
        if (/구$/.test(p) && i > 0) return p.replace(/구$/, '');
      }
      return parts[0];
    }
    function shortName(m) {
      return m.t.replace(/\(.*?\)/, '').trim() + ' ' + extractCity(m.a);
    }
    function getProvince(addr) { return addr.split(/\s+/)[0]; }
    function haversine(lat1, lng1, lat2, lng2) {
      var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      var a = Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
      return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
    }

    var listEl = document.getElementById('mountain-list');

    // 툴팁 표시
    function showTooltip(m, i) {
      var sn = shortName(m);
      document.getElementById('tt-name').textContent = sn;
      document.getElementById('tt-addr').textContent = m.a;
      document.getElementById('tt-height').textContent = '해발 ' + m.h + 'm';
      var name = encodeURIComponent(sn);
      document.getElementById('tt-naver').onclick = function(e) { e.stopPropagation(); window.open('https://map.naver.com/v5/search/' + name, '_blank'); };
      document.getElementById('tt-kakao').onclick = function(e) { e.stopPropagation(); window.open('https://map.kakao.com/link/map/' + name + ',' + m.lat + ',' + m.lng, '_blank'); };
      document.getElementById('tt-google').onclick = function(e) { e.stopPropagation(); window.open('https://www.google.com/maps/search/?q=' + m.lat + ',' + m.lng, '_blank'); };
      var mapRect = document.getElementById('map').getBoundingClientRect();
      var isMob = window.innerWidth < 1024;
      tooltip.classList.remove('hidden');
      if (isMob) {
        tooltip.style.top = Math.max(8, mapRect.top + 8) + 'px';
        tooltip.style.right = '8px';
        tooltip.style.left = 'auto';
      } else {
        var rightOff = (window.innerWidth - mapRect.right) + 8;
        tooltip.style.top = (mapRect.top + 50) + 'px';
        tooltip.style.right = rightOff + 'px';
        tooltip.style.left = 'auto';
      }
      // 목록 스크롤 (모바일/PC 모두 listEl 내부 스크롤)
      var li = listEl.querySelector('[data-idx="' + i + '"]');
      if (li) listEl.scrollTo({ top: li.offsetTop, behavior: 'smooth' });
    }
    function hideTooltip() { tooltip.classList.add('hidden'); }
    document.getElementById('tt-close').addEventListener('click', function(e) { e.stopPropagation(); hideTooltip(); });
    tooltip.addEventListener('click', function(e) { e.stopPropagation(); });
    document.addEventListener('click', hideTooltip);

    // 필터 그룹
    var filterGroups = [
      { label: '전체',      provinces: null },
      { label: '강원',      provinces: ['강원'] },
      { label: '경기·서울', provinces: ['경기', '서울', '인천'] },
      { label: '경남',      provinces: ['경남', '울산', '부산'] },
      { label: '경북',      provinces: ['경북', '대구'] },
      { label: '전남',      provinces: ['전남', '광주'] },
      { label: '전북',      provinces: ['전북'] },
      { label: '제주',      provinces: ['제주'] },
      { label: '충남',      provinces: ['충남'] },
      { label: '충북',      provinces: ['충북'] },
    ];

    function matchesFilter(m) {
      var g = null;
      for (var i = 0; i < filterGroups.length; i++) {
        if (filterGroups[i].label === currentFilter) { g = filterGroups[i]; break; }
      }
      return !g || !g.provinces || g.provinces.indexOf(getProvince(m.a)) !== -1;
    }

    // 필터 칩 업데이트 (모바일 + PC 동시)
    function updateFilterChips() {
      document.querySelectorAll('.filter-chip').forEach(function(c) {
        var active = c.dataset.label === currentFilter;
        c.className = 'filter-chip flex-shrink-0 text-xs px-2.5 py-1 rounded-full border transition-colors ' +
          (active ? 'bg-sky-500 text-white border-sky-500' : 'bg-white text-gray-600 border-gray-200');
      });
    }
    // 정렬 select 동기화
    function updateSortSelects() {
      document.querySelectorAll('.sort-select').forEach(function(s) { s.value = currentSort; });
    }

    // 목록 렌더링
    function renderList() {
      var searchEl = document.getElementById('search') || document.getElementById('search-mob');
      var q = searchEl ? searchEl.value.trim() : '';
      var filtered = mountains.filter(function(m) {
        return matchesFilter(m) && (!q || m.t.indexOf(q) !== -1 || m.a.indexOf(q) !== -1);
      });
      filtered.sort(function(a, b) {
        if (currentSort === 'height') return parseInt(b.h.replace(',','')) - parseInt(a.h.replace(',',''));
        if (currentSort === 'distance' && userLat !== null)
          return haversine(userLat, userLng, a.lat, a.lng) - haversine(userLat, userLng, b.lat, b.lng);
        return a.t.localeCompare(b.t, 'ko');
      });
      var countText = '총 ' + filtered.length + '개';
      var cEl = document.getElementById('mountain-count');
      var cElMob = document.getElementById('mountain-count-mob');
      if (cEl) cEl.textContent = countText;
      if (cElMob) cElMob.textContent = countText;

      listEl.innerHTML = '';

      filtered.forEach(function(m) {
        var i = mountains.indexOf(m);
        var sn = shortName(m);
        var rightText = (currentSort === 'distance' && userLat !== null)
          ? haversine(userLat, userLng, m.lat, m.lng).toFixed(1) + 'km'
          : m.h + 'm';

        var li = document.createElement('li');
        li.dataset.idx = i;
        li.className = 'px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-sky-50 transition-colors';
        li.innerHTML =
          '<div>' +
            '<span class="text-sm font-medium text-gray-800">' + sn + '</span>' +
            '<span class="block text-xs text-gray-400 mt-0.5">' + m.a + '</span>' +
          '</div>' +
          '<span class="text-xs text-gray-400 ml-2 flex-shrink-0">' + rightText + '</span>';

        li.addEventListener('click', function(e) {
          e.stopPropagation();
          if (map) { map.setCenter(new kakao.maps.LatLng(m.lat, m.lng)); map.setLevel(9); }
          if (selectMarkerFn && markers[i]) selectMarkerFn(i);
          showTooltip(m, i);
        });

        listEl.appendChild(li);
      });
    }

    // 필터 칩 생성 (모바일/PC 각 컨테이너)
    ['filter-chips-mob', 'filter-chips'].forEach(function(elId) {
      var el = document.getElementById(elId);
      if (!el) return;
      filterGroups.forEach(function(g) {
        var btn = document.createElement('button');
        btn.textContent = g.label;
        btn.dataset.label = g.label;
        btn.className = 'filter-chip flex-shrink-0 text-xs px-2.5 py-1 rounded-full border transition-colors ' +
          (g.label === '전체' ? 'bg-sky-500 text-white border-sky-500' : 'bg-white text-gray-600 border-gray-200');
        btn.addEventListener('click', function() {
          currentFilter = g.label;
          updateFilterChips();
          renderList();
          applyFilterToMap();
        });
        el.appendChild(btn);
      });
    });

    // 정렬 select 이벤트 (모바일/PC 동기화)
    function bindSortSelect(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.classList.add('sort-select');
      el.addEventListener('change', function() {
        currentSort = el.value;
        updateSortSelects();
        if (currentSort === 'distance') requestLocation();
        else renderList();
      });
    }
    bindSortSelect('sort-select');
    bindSortSelect('sort-select-mob');

    // 검색 (모바일/PC 동기화)
    function syncSearch(srcId, dstId) {
      var src = document.getElementById(srcId);
      var dst = document.getElementById(dstId);
      if (src) src.addEventListener('input', function() {
        if (dst) dst.value = src.value;
        renderList();
      });
    }
    syncSearch('search', 'search-mob');
    syncSearch('search-mob', 'search');

    // 내 위치
    function placeMyMarker(lat, lng, isDefault) {
      if (!map) return;
      if (myMarker) myMarker.setMap(null);
      var sz = new kakao.maps.Size(20, 20), opt = { offset: new kakao.maps.Point(10, 10) };
      var img = new kakao.maps.MarkerImage(
        'data:image/svg+xml,' + encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20">' +
          '<circle cx="10" cy="10" r="10" fill="#f97316" opacity="0.25"/>' +
          '<circle cx="10" cy="10" r="6" fill="#f97316" stroke="white" stroke-width="2"/></svg>'
        ), sz, opt
      );
      myMarker = new kakao.maps.Marker({ map, position: new kakao.maps.LatLng(lat, lng),
        title: isDefault ? '기본 위치 (남산)' : '내 위치', image: img });
    }
    function setLocation(lat, lng, isDefault) {
      userLat = lat; userLng = lng;
      placeMyMarker(lat, lng, isDefault);
      renderList();
    }
    function requestLocation() {
      if (userLat !== null) { renderList(); return; }
      if (!navigator.geolocation) { setLocation(NAMSAN_LAT, NAMSAN_LNG, true); return; }
      navigator.geolocation.getCurrentPosition(
        function(p) { setLocation(p.coords.latitude, p.coords.longitude, false); },
        function()  { setLocation(NAMSAN_LAT, NAMSAN_LNG, true); },
        { timeout: 8000 }
      );
    }

    // 지도에 필터 마커 적용
    function applyFilterToMap() {
      if (!map) return;
      var bounds = new kakao.maps.LatLngBounds();
      mountains.forEach(function(m, i) {
        if (!markers[i]) return;
        var visible = matchesFilter(m);
        if (visible) {
          if (i === selectedIdx) { markers[i].normal.setMap(null); markers[i].active.setMap(map); }
          else { markers[i].normal.setMap(map); markers[i].active.setMap(null); }
          bounds.extend(new kakao.maps.LatLng(m.lat, m.lng));
        } else {
          markers[i].normal.setMap(null); markers[i].active.setMap(null);
          if (i === selectedIdx) selectedIdx = null;
        }
      });
      if (currentFilter === '전체') {
        map.setCenter(new kakao.maps.LatLng(DEFAULT_LAT, DEFAULT_LNG));
        map.setLevel(DEFAULT_LEVEL);
      } else {
        map.setBounds(bounds);
        setTimeout(function() { map.setLevel(DEFAULT_LEVEL - 1); }, 50);
      }
    }

    // 지도 초기화
    var isMobile = window.innerWidth < 1024;
    var DEFAULT_LAT = isMobile ? 36.8 : 36.5;
    var DEFAULT_LNG = 127.8;
    var DEFAULT_LEVEL = isMobile ? 13 : 12;

    function initMap() {
      map = new kakao.maps.Map(document.getElementById('map'), {
        center: new kakao.maps.LatLng(DEFAULT_LAT, DEFAULT_LNG),
        level: DEFAULT_LEVEL,
      });
      var mkSize = new kakao.maps.Size(18,18), mkOpt = { offset: new kakao.maps.Point(9,9) };
      var normalImage = new kakao.maps.MarkerImage(
        'data:image/svg+xml,' + encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18">' +
          '<circle cx="9" cy="9" r="7" fill="#0ea5e9" stroke="white" stroke-width="2"/></svg>'
        ), mkSize, mkOpt
      );
      var activeImage = new kakao.maps.MarkerImage(
        'data:image/svg+xml,' + encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18">' +
          '<circle cx="9" cy="9" r="7" fill="#0c4a6e" stroke="white" stroke-width="2"/></svg>'
        ), mkSize, mkOpt
      );
      selectMarkerFn = function(idx) {
        if (selectedIdx !== null) {
          markers[selectedIdx].active.setMap(null);
          markers[selectedIdx].normal.setMap(map);
        }
        markers[idx].normal.setMap(null);
        markers[idx].active.setMap(map);
        selectedIdx = idx;
      };
      mountains.forEach(function(m, i) {
        var pos = new kakao.maps.LatLng(m.lat, m.lng);
        var nm = new kakao.maps.Marker({ map, position: pos, title: shortName(m), image: normalImage });
        var am = new kakao.maps.Marker({ position: pos, title: shortName(m), image: activeImage });
        markers[i] = { normal: nm, active: am };
        var handler = (function(mi, pi, idx) {
          return function() {
            selectMarkerFn(idx);
            map.setCenter(pi);
            map.setLevel(9);
            showTooltip(mi, idx);
          };
        })(m, pos, i);
        kakao.maps.event.addListener(nm, 'click', handler);
        kakao.maps.event.addListener(am, 'click', handler);
      });
      if (userLat !== null) placeMyMarker(userLat, userLng, false);
    }

    // 초기 실행
    renderList();
    if (typeof kakao !== 'undefined') initMap();
    else window.addEventListener('load', initMap);
  })();
  </script>
</BaseLayout>
