---
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dir = path.resolve(process.cwd(), 'src/data/security-questions');
  const files = fs.readdirSync(dir).filter((f: string) => f.endsWith('.json'));
  return files.map((file: string) => {
    const slug = file.replace('.json', '');
    return { params: { slug }, props: { slug } };
  });
}

const { slug } = Astro.props;
const redirectTo = `/learn/certs/security/exam/written/${slug}/`;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
  <link rel="canonical" href={`https://daparapara.com${redirectTo}`} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <script define:vars={{ redirectTo }}>window.location.replace(redirectTo);</script>
</body>
</html>
