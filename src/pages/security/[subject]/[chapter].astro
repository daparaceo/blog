---
import { CHAPTERS } from '../../../data/security-chapters';

export async function getStaticPaths() {
  return CHAPTERS.map(ch => ({
    params: { subject: ch.subject, chapter: ch.chapter },
    props: { subject: ch.subject, chapter: ch.chapter },
  }));
}

const { subject, chapter } = Astro.props;
const redirectTo = `/learn/certs/security/${subject}/${chapter}/`;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
  <link rel="canonical" href={`https://daparapara.com${redirectTo}`} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <script define:vars={{ redirectTo }}>window.location.replace(redirectTo);</script>
</body>
</html>
