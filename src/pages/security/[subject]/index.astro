---
export async function getStaticPaths() {
  return ['system', 'network', 'application', 'general', 'law'].map(subject => ({
    params: { subject },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const redirectTo = `/learn/certs/security/${subject}/`;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
  <link rel="canonical" href={`https://daparapara.com${redirectTo}`} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <script define:vars={{ redirectTo }}>window.location.replace(redirectTo);</script>
</body>
</html>
