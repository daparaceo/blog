---

<BaseLayout
  title="블랙야크 명산 100"
  description="블랙야크 명산100 챌린지 산 목록과 위치를 지도에서 확인하세요. 각 산의 위치를 네이버 지도에 저장할 수 있습니다."
  noPadding={true}
>
  <Fragment set:html={`<script src="//dapi.kakao.com/v2/maps/sdk.js?appkey=${kakaoKey}"><\/script>`} slot="head" />
  <div class="flex flex-col lg:flex-row h-[calc(100dvh-var(--header-h,4rem))] lg:h-[calc(100vh-4rem)] overflow-hidden">

    <!-- 지도 영역 -->
    <div class="relative w-full lg:w-2/3 flex-shrink-0 h-[55dvh] lg:h-full lg:flex-shrink z-0">
      <div id="map" class="w-full h-full"></div>
      <button id="reset-view" class="absolute top-2 right-2 z-10 bg-white text-xs font-medium px-2.5 py-1.5 rounded shadow-md border border-gray-200 hover:bg-gray-50 transition-colors">전체</button>
    </div>

    <!-- 목록 패널 -->
    <div class="w-full lg:w-1/3 flex flex-col border-t lg:border-t-0 lg:border-l border-gray-200 overflow-hidden">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex-shrink-0">
        <h1 class="text-base font-bold text-gray-800">블랙야크 명산100</h1>
        <p class="text-xs text-gray-500 mt-0.5">총 99개 · 클릭하면 지도에서 확인</p>
        <input
          id="search"
          type="text"
          placeholder="산 이름 검색..."
          class="mt-2 w-full px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-sky-400"
        />
      </div>
      <ul id="mountain-list" class="overflow-y-auto flex-1 divide-y divide-gray-100"></ul>
    </div>
  </div>

  <!-- 툴팁 -->
  <div id="tooltip" class="fixed z-50 hidden bg-white rounded-xl shadow-xl border border-gray-100 p-4 w-72 max-w-[90vw]">
    <button id="tooltip-close" class="absolute top-2 right-3 text-gray-400 hover:text-gray-600 text-lg leading-none">&times;</button>
    <h2 id="tt-name" class="text-base font-bold text-gray-900 pr-5"></h2>
    <p id="tt-addr" class="text-xs text-gray-500 mt-0.5"></p>
    <div class="flex items-center gap-3 mt-2 text-xs text-gray-600">
      <span id="tt-height" class="font-medium"></span>
      <span id="tt-gps" class="text-gray-400"></span>
    </div>
    <div class="mt-3 flex gap-2">
      <a id="tt-naver" href="#" target="_blank"
        class="flex-1 text-center text-xs font-medium px-3 py-2 rounded-lg bg-sky-500 text-white hover:bg-sky-600 transition-colors">
        네이버 지도에서 보기
      </a>
      <a id="tt-nmap" href="#"
        class="flex-1 text-center text-xs font-medium px-3 py-2 rounded-lg bg-emerald-500 text-white hover:bg-emerald-600 transition-colors">
        위치 저장
      </a>
    </div>
  </div>

  <Fragment set:html={`<script>window.__M__=${mountainsJson};window.__KK__='${kakaoKey}';<\/script>`} />
  <script is:inline>
  (function() {
    var mountains = window.__M__;
    var kakaoKey = window.__KK__;
    var map = null;
    var mapEl = document.getElementById('map');

    var tooltip = document.getElementById('tooltip');
    var ttName = document.getElementById('tt-name');
    var ttAddr = document.getElementById('tt-addr');
    var ttHeight = document.getElementById('tt-height');
    var ttGps = document.getElementById('tt-gps');
    var ttNaver = document.getElementById('tt-naver');
    var ttNmap = document.getElementById('tt-nmap');
    document.getElementById('tooltip-close').addEventListener('click', function() {
      tooltip.classList.add('hidden');
    });
    document.addEventListener('click', function(e) {
      if (!tooltip.contains(e.target) && !e.target.closest('#map')) {
        tooltip.classList.add('hidden');
      }
    });

    function showTooltip(m, markerPos) {
      ttName.textContent = m.t;
      ttAddr.textContent = m.a;
      ttHeight.textContent = m.h + 'm';
      ttGps.textContent = m.lat.toFixed(5) + ', ' + m.lng.toFixed(5);

      var naverUrl = 'https://map.naver.com/v5/search/' + encodeURIComponent(m.t);
      ttNaver.href = naverUrl;

      var nmapUrl = 'nmap://place?lat=' + m.lat + '&lng=' + m.lng + '&name=' + encodeURIComponent(m.t) + '&appname=com.daparapara.blog';
      ttNmap.onclick = function(e) {
        e.preventDefault();
        var isMobile = /Android|iPhone|iPad/i.test(navigator.userAgent);
        window.location.href = isMobile ? nmapUrl : naverUrl;
      };

      var btnRect = document.getElementById('reset-view').getBoundingClientRect();
      tooltip.style.top = (btnRect.bottom + 8) + 'px';
      tooltip.style.right = (window.innerWidth - btnRect.right) + 'px';
      tooltip.style.left = 'auto';
      tooltip.style.transform = '';
      tooltip.classList.remove('hidden');
    }

    // 목록은 SDK와 무관하게 즉시 생성
    var listEl = document.getElementById('mountain-list');
    mountains.forEach(function(m, i) {
      var li = document.createElement('li');
      li.dataset.idx = i;
      li.className = 'px-4 py-3 flex justify-between items-center cursor-pointer hover:bg-sky-50 transition-colors';
      li.innerHTML =
        '<div>' +
          '<span class="text-sm font-medium text-gray-800">' + m.t + '</span>' +
          '<span class="block text-xs text-gray-400 mt-0.5">' + m.a + '</span>' +
        '</div>' +
        '<span class="text-xs text-gray-400 ml-2 flex-shrink-0">' + m.h + 'm</span>';
      li.addEventListener('click', function(e) {
        e.stopPropagation();
        if (map) { map.setCenter(new kakao.maps.LatLng(m.lat, m.lng)); map.setLevel(5); }
        showTooltip(m, null);
      });
      listEl.appendChild(li);
    });

    document.getElementById('search').addEventListener('input', function(e) {
      var q = e.target.value.trim();
      listEl.querySelectorAll('li').forEach(function(li) {
        var idx = parseInt(li.dataset.idx);
        var visible = !q || mountains[idx].t.indexOf(q) !== -1 || mountains[idx].a.indexOf(q) !== -1;
        li.style.display = visible ? '' : 'none';
      });
    });

    var isMobile = window.innerWidth < 1024;
    var DEFAULT_LAT = isMobile ? 36.8 : 36.5;
    var DEFAULT_LNG = 127.8;
    var DEFAULT_LEVEL = isMobile ? 13 : 12;

    // 카카오맵 SDK 로드 후 지도·마커 초기화
    function initMap() {
      map = new kakao.maps.Map(mapEl, {
        center: new kakao.maps.LatLng(DEFAULT_LAT, DEFAULT_LNG),
        level: DEFAULT_LEVEL,
      });

      document.getElementById('reset-view').addEventListener('click', function() {
        map.setCenter(new kakao.maps.LatLng(DEFAULT_LAT, DEFAULT_LNG));
        map.setLevel(DEFAULT_LEVEL);
        tooltip.classList.add('hidden');
      });

      var svgIcon = 'data:image/svg+xml,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18">' +
        '<circle cx="9" cy="9" r="7" fill="#0ea5e9" stroke="white" stroke-width="2"/>' +
        '</svg>'
      );
      var markerImage = new kakao.maps.MarkerImage(
        svgIcon,
        new kakao.maps.Size(18, 18),
        { offset: new kakao.maps.Point(9, 9) }
      );

      mountains.forEach(function(m) {
        var pos = new kakao.maps.LatLng(m.lat, m.lng);
        var marker = new kakao.maps.Marker({ map: map, position: pos, title: m.t, image: markerImage });
        kakao.maps.event.addListener(marker, 'click', function() {
          map.setCenter(pos);
          showTooltip(m, pos);
        });
      });
    }

    if (typeof kakao !== 'undefined') {
      initMap();
    } else {
      window.addEventListener('load', initMap);
    }
  })();
  </script>
</BaseLayout>
