---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { CHAPTERS } from '../../../../../data/certs/security/chapters';
import { createImageResolver, getAnswers, getAnswerText, escapeHtml, loadAllQuestions } from '../../../../../lib/certs';

// 실전 모의고사: 전 회차 기출을 문제 풀로 두고, 과목별 20문제를 브라우저에서 무작위로 뽑는다.
// 정적 사이트라 빌드 시 전체 풀을 숨겨서 렌더링하고, 스크립트가 뽑힌 문제만 보여준다.

const subjectOrder = ['시스템보안', '네트워크보안', '어플리케이션보안', '정보보안일반', '정보보안관리및법규'];
const PER_SUBJECT = 20;

// 회차 간 동일 문제(문항+선택지 일치)는 하나만 남긴다
const normalize = (s: string) => s.replace(/[^\p{L}\p{N}]/gu, '').toLowerCase();
const seen = new Set<string>();
const pool = loadAllQuestions('security').filter(q => {
  const key = `${normalize(q.question)}|${q.options.map(normalize).sort().join('|')}`;
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});

const images = createImageResolver('security');
const optionSymbols = ['①', '②', '③', '④'];

function formatSecurityText(value: string) {
  const escaped = escapeHtml(value);
  if (/^(?:find|chmod|ls|cat|grep|sudo)\b|^-perm\b|^\/(?:etc|var|tmp|home|root)\/|^(?:\*|\d{1,2})\s+(?:\*|\d{1,2})\s+(?:\*|\d{1,2})/.test(escaped)) {
    return `<code>${escaped}</code>`;
  }
  return escaped.replace(
    /((?:HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER|HKEY_CLASSES_ROOT|HKEY_CURRENT_CONFIG|HKEY_USERS|HKLM|HKCU|HKCR|HKCC|%SystemRoot%)(?:\\[A-Za-z0-9_. -]*[A-Za-z0-9_.-])+)/g,
    '<code>$1</code>'
  );
}

function getRelatedChapters(q: any) {
  const questionText = (q.question ?? '').toLowerCase();
  const optionText = (q.options ?? []).join(' ').toLowerCase();
  const explanationText = (q.explanation ?? '').toLowerCase();
  const metaText = `${q.topic ?? ''} ${(q.tags ?? []).join(' ')}`.toLowerCase();

  return CHAPTERS
    .map(ch => {
      let score = 0;
      ch.keywords.forEach(kw => {
        const keyword = kw.toLowerCase();
        if (questionText.includes(keyword) || metaText.includes(keyword)) score += 2;
        else if (optionText.includes(keyword) || explanationText.includes(keyword)) score += 1;
      });
      if (score > 0 && ch.subjectLabel === q.subject) score += 1;
      return { ...ch, _score: score };
    })
    .filter(ch => ch._score >= 3)
    .sort((a, b) => b._score - a._score)
    .slice(0, 3);
}
---

<BaseLayout
  title="정보보안기사 실전 모의고사"
  description="정보보안기사 필기 전 회차 기출에서 과목별 20문제씩 무작위로 출제되는 실전 모의고사 — 개별 채점 및 전체 채점 지원"
>
  <div class="space-y-8">

    <div class="border-b border-gray-200 pb-4">
      <div class="text-xs text-gray-400 mb-1">
        <a href="/learn/certs/security/" class="hover:text-sky-600">보안기사</a>
        <span class="mx-1">/</span>
        실전 모의고사 (필기)
      </div>
      <h1 class="text-xl font-bold text-gray-900">정보보안기사 실전 모의고사</h1>
      <p class="text-sm text-gray-500 mt-1">
        기출 {pool.length}문제 중 과목별 {PER_SUBJECT}문제 무작위 출제 · 총 {PER_SUBJECT * subjectOrder.length}문제 · 60점 이상 합격
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button id="submit-all" class="px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">
        전체 채점하기
      </button>
      <button id="reset-all" class="px-5 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
        초기화
      </button>
      <button id="new-exam" class="px-5 py-2 bg-white border border-sky-300 text-sky-700 text-sm font-medium rounded-lg hover:bg-sky-50 transition-colors">
        새 문제 뽑기
      </button>
    </div>

    <div id="score-section" class="hidden border border-indigo-200 bg-indigo-50 rounded-lg p-4">
      <p class="text-indigo-700 font-semibold text-lg" id="score-display"></p>
      <p class="text-indigo-500 text-sm mt-1" id="score-detail"></p>
      <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-sm" id="score-subjects"></ul>
    </div>

    <noscript>
      <p class="text-sm text-gray-500">모의고사 문제 출제에는 자바스크립트가 필요합니다.</p>
    </noscript>

    {subjectOrder.map((subject) => (
      <section class="mock-subject" data-subject={subject}>
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4 border-b border-gray-100 pb-2">
          {subject}
        </h2>
        <div class="mock-list space-y-6"></div>
      </section>
    ))}

    <div id="mock-pool" hidden>
      {pool.map((q) => (
        <div
          class="question-item border border-gray-200 rounded-lg p-5"
          data-answers={getAnswers(q).join(',')}
          data-subject={q.subject}
          data-id={q.id}
        >
          <p class="font-medium text-gray-900 mb-4 leading-relaxed">
            <span class="q-number text-gray-400 mr-1"></span>
            <Fragment set:html={formatSecurityText(q.question)} />
          </p>

          {images.question(q).map((image, imageIndex) => (
            <figure class="mb-4">
              <img src={image} alt={`${q.year}년 ${q.session}회 ${q.number}번 문제 참고 이미지 ${imageIndex + 1}`} loading="lazy" decoding="async" class="max-w-full h-auto rounded border border-gray-200" />
            </figure>
          ))}

          <div class="space-y-2 mb-4">
            {q.options.map((opt: string, i: number) => (
              <label class="option-label flex items-start gap-2 p-2 rounded cursor-pointer hover:bg-gray-50 transition-colors">
                <input type="radio" name={`q-${q.id}`} value={i + 1} class="mt-0.5 accent-sky-600 shrink-0" />
                <span class="min-w-0 flex-1">
                  <span class="block text-sm text-gray-700" style="overflow-wrap:anywhere" set:html={formatSecurityText(opt)}></span>
                  {images.option(q, i + 1).map((image, imageIndex) => (
                    <img src={image} alt={`${q.year}년 ${q.session}회 ${q.number}번 ${optionSymbols[i]} 선택지 참고 이미지 ${imageIndex + 1}`} loading="lazy" decoding="async" class="max-w-full h-auto mt-2 rounded border border-gray-200" />
                  ))}
                </span>
              </label>
            ))}
          </div>

          <div class="flex items-center gap-2">
            <button class="check-btn text-xs px-3 py-1.5 bg-sky-600 text-white rounded hover:bg-sky-700 transition-colors">
              정답 확인
            </button>
          </div>

          <div class="explanation-box hidden mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
            <p class="text-xs font-semibold text-gray-600 mb-1">
              정답: <Fragment set:html={formatSecurityText(getAnswerText(q))} />
            </p>
            {q.explanation && (
              <p class="text-xs text-gray-500 leading-relaxed" set:html={formatSecurityText(q.explanation)}></p>
            )}
            <p class="text-xs text-gray-400 mt-2">
              출처: <a href={`/learn/certs/security/exam/written/${q.examSlug}/`} class="hover:text-sky-600">{q.year}년 {q.session}회 {q.number}번</a>
            </p>
            {getRelatedChapters(q).length > 0 && (
              <div class="mt-2">
                <p class="text-xs font-semibold text-gray-500 mb-1">관련 개념</p>
                <div class="flex flex-wrap gap-1.5">
                  {getRelatedChapters(q).map(ch => (
                    <a href={`/learn/certs/security/${ch.subject}/${ch.chapter}/`} class="text-xs text-sky-600 hover:text-sky-700 bg-sky-50 px-2 py-1 rounded">
                      {ch.chapterLabel}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-gray-200">
      <button id="submit-all-bottom" class="px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">
        전체 채점하기
      </button>
      <button id="reset-all-bottom" class="px-5 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
        초기화
      </button>
      <button id="new-exam-bottom" class="px-5 py-2 bg-white border border-sky-300 text-sky-700 text-sm font-medium rounded-lg hover:bg-sky-50 transition-colors">
        새 문제 뽑기
      </button>
    </div>

  </div>
</BaseLayout>

<style>
  .option-label.correct { background-color: #f0fdf4; border: 1px solid #86efac; color: #15803d; }
  .option-label.wrong   { background-color: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; }
  .option-label.correct span, .option-label.wrong span { font-weight: 500; }
  .question-item code { overflow-wrap: anywhere; word-break: break-word; }
</style>

<script is:inline define:vars={{ perSubject: PER_SUBJECT }}>
  document.addEventListener('DOMContentLoaded', function () {
    const poolEl = document.getElementById('mock-pool');
    const sections = Array.from(document.querySelectorAll('.mock-subject'));

    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
      }
      return arr;
    }

    function activeItems() {
      return Array.from(document.querySelectorAll('.mock-list .question-item'));
    }

    function clearItem(item) {
      item.querySelectorAll('input[type=radio]').forEach(function (r) { r.checked = false; });
      item.querySelectorAll('.option-label').forEach(function (label) { label.classList.remove('correct', 'wrong'); });
      const box = item.querySelector('.explanation-box');
      if (box) box.classList.add('hidden');
      const btn = item.querySelector('.check-btn');
      if (btn) btn.textContent = '정답 확인';
    }

    // 과목별로 겹치지 않게 perSubject 문제를 뽑아 1번부터 다시 번호를 매긴다
    function drawExam() {
      activeItems().forEach(function (item) { clearItem(item); poolEl.appendChild(item); });
      const all = Array.from(poolEl.querySelectorAll('.question-item'));
      let number = 1;
      sections.forEach(function (section) {
        const list = section.querySelector('.mock-list');
        const picked = shuffle(all.filter(function (item) { return item.dataset.subject === section.dataset.subject; })).slice(0, perSubject);
        picked.forEach(function (item) {
          item.querySelector('.q-number').textContent = number++ + '.';
          list.appendChild(item);
        });
      });
      document.getElementById('score-section').classList.add('hidden');
    }

    function gradeQuestion(item) {
      const answers = (item.dataset.answers || '').split(',').map(Number);
      const selected = item.querySelector('input[type=radio]:checked');
      const isCorrect = selected && answers.includes(parseInt(selected.value, 10));

      item.querySelectorAll('.option-label').forEach(function (label) {
        label.classList.remove('correct', 'wrong');
        const radio = label.querySelector('input[type=radio]');
        if (!radio) return;
        const val = parseInt(radio.value, 10);
        if (answers.includes(val)) label.classList.add('correct');
        else if (selected && val === parseInt(selected.value, 10)) label.classList.add('wrong');
      });

      const box = item.querySelector('.explanation-box');
      if (box) box.classList.remove('hidden');
      return isCorrect;
    }

    document.querySelectorAll('.check-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const item = btn.closest('.question-item');
        const box = item.querySelector('.explanation-box');
        if (box.classList.contains('hidden')) {
          gradeQuestion(item);
          btn.textContent = '정답 숨기기';
        } else {
          item.querySelectorAll('.option-label').forEach(function (label) { label.classList.remove('correct', 'wrong'); });
          box.classList.add('hidden');
          btn.textContent = '정답 확인';
        }
      });
    });

    // 합격 기준: 전 과목 평균 60점 이상 + 과목별 40점 이상 (한 과목이라도 40점 미만이면 과락)
    const PASS_AVERAGE = 60;
    const PASS_SUBJECT = 40;

    function renderScore(items) {
      const bySubject = new Map();
      items.forEach(function (item) {
        const subject = item.dataset.subject;
        if (!bySubject.has(subject)) bySubject.set(subject, { total: 0, correct: 0 });
        const row = bySubject.get(subject);
        row.total++;
        if (item.dataset.correct === '1') row.correct++;
      });

      const rows = Array.from(bySubject.entries()).map(function (entry) {
        const row = entry[1];
        return { subject: entry[0], correct: row.correct, total: row.total, score: Math.round((row.correct / row.total) * 100) };
      });
      const correct = rows.reduce(function (sum, r) { return sum + r.correct; }, 0);
      const average = Math.round(rows.reduce(function (sum, r) { return sum + r.score; }, 0) / rows.length);
      const failed = rows.filter(function (r) { return r.score < PASS_SUBJECT; });

      document.getElementById('score-display').textContent = correct + ' / ' + items.length + '문제 · 평균 ' + average + '점';
      let verdict;
      if (failed.length > 0) verdict = '불합격 — 과락 ' + failed.map(function (r) { return r.subject; }).join(', ') + ' (과목별 ' + PASS_SUBJECT + '점 미만)';
      else if (average < PASS_AVERAGE) verdict = '불합격 — 평균 ' + PASS_AVERAGE + '점 미만';
      else verdict = '합격 — 평균 ' + PASS_AVERAGE + '점 이상, 전 과목 ' + PASS_SUBJECT + '점 이상';
      document.getElementById('score-detail').textContent = verdict;

      const list = document.getElementById('score-subjects');
      list.innerHTML = '';
      rows.forEach(function (r) {
        const li = document.createElement('li');
        const fail = r.score < PASS_SUBJECT;
        li.className = 'flex justify-between ' + (fail ? 'text-red-600 font-medium' : 'text-indigo-600');
        const name = document.createElement('span');
        name.textContent = r.subject + (fail ? ' (과락)' : '');
        const value = document.createElement('span');
        value.textContent = r.correct + '/' + r.total + ' · ' + r.score + '점';
        li.append(name, value);
        list.appendChild(li);
      });

      const scoreSection = document.getElementById('score-section');
      scoreSection.classList.remove('hidden');
      scoreSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function submitAll() {
      const items = activeItems();
      items.forEach(function (item) { item.dataset.correct = gradeQuestion(item) ? '1' : '0'; });
      renderScore(items);
    }

    function resetAll() {
      activeItems().forEach(clearItem);
      document.getElementById('score-section').classList.add('hidden');
    }

    function newExam() {
      const answered = document.querySelector('.mock-list input[type=radio]:checked');
      if (answered && !confirm('지금까지 고른 답이 사라집니다. 새 문제를 뽑을까요?')) return;
      drawExam();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.getElementById('submit-all').addEventListener('click', submitAll);
    document.getElementById('submit-all-bottom').addEventListener('click', submitAll);
    document.getElementById('reset-all').addEventListener('click', resetAll);
    document.getElementById('reset-all-bottom').addEventListener('click', resetAll);
    document.getElementById('new-exam').addEventListener('click', newExam);
    document.getElementById('new-exam-bottom').addEventListener('click', newExam);

    drawExam();
  });
</script>
