---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import CertExam from '../../../../../../components/certs/CertExam.astro';
import { listCerts, listExamSlugs, loadExam, examTitle, type CertConfig } from '../../../../../../lib/certs';

export function getStaticPaths() {
  return listCerts().flatMap(config =>
    listExamSlugs(config.slug).map(slug => ({ params: { cert: config.slug, slug }, props: { config, slug } }))
  );
}

const { config, slug } = Astro.props as { config: CertConfig; slug: string };
const questions = loadExam(config.slug, slug);
const title = `${examTitle('written', slug)} ${config.shortName}`;
---

<BaseLayout
  title={`${title} 필기 기출문제`}
  description={`${config.name} ${examTitle('written', slug)} 기출문제 ${questions.length}문제 — 문항별 해설, 개별 채점과 전체 채점 지원`}
>
  <CertExam config={config} questions={questions} title={title} crumb="기출문제 (필기)" note={config.sourceNote} />
</BaseLayout>
