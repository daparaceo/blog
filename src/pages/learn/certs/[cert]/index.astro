---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { listCerts, getChapters, listExamSlugs, examTitle, examHref, type CertConfig } from '../../../../lib/certs';

export function getStaticPaths() {
  return listCerts().map(config => ({ params: { cert: config.slug }, props: { config } }));
}

const { config } = Astro.props as { config: CertConfig };
const chapters = getChapters(config.slug);
const examSlugs = listExamSlugs(config.slug).reverse();
const predictedSlugs = listExamSlugs(config.slug, 'predicted');
const totalQuestions = config.subjects.reduce((sum, s) => sum + s.questions, 0);
const subjects = config.subjects.map(s => ({ ...s, chapters: chapters.filter(ch => ch.subject === s.slug) }));
---

<BaseLayout title={`${config.shortName} 학습`} description={config.description}>
  <div class="space-y-10" data-pagefind-body>

    <div class="border-b border-gray-200 pb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{config.name}</h1>
      <p class="text-gray-500 text-sm">{config.examSummary ?? `${config.subjects.length}과목 · 총 ${totalQuestions}문제 · ${config.passScore}점 이상 합격`}</p>
    </div>

    <section>
      <h2 class="text-base font-semibold text-gray-700 mb-4">{config.subjectHeading ?? '과목별 요점 정리'}</h2>
      <div class="space-y-3">
        {subjects.map(subject => (
          <div class="border border-gray-200 rounded-lg overflow-hidden">
            <a href={`/learn/certs/${config.slug}/${subject.slug}/`} class="flex items-center justify-between px-4 py-3 hover:bg-sky-50 transition-colors group">
              <span>
                <span class="font-semibold text-gray-900 group-hover:text-sky-700">{subject.label}</span>
                <span class="block text-xs text-gray-400 mt-0.5">{subject.desc}</span>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            {subject.chapters.length > 0 && (
              <div class="flex flex-wrap gap-2 px-4 py-2 border-t border-gray-100 bg-gray-50">
                {subject.chapters.map(ch => (
                  <a href={`/learn/certs/${config.slug}/${subject.slug}/${ch.chapter}/`} class="text-xs px-2.5 py-1 rounded-full bg-white border border-gray-200 text-gray-500 hover:bg-sky-100 hover:text-sky-700 hover:border-sky-200 transition-colors">
                    {ch.chapterLabel}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {predictedSlugs.length > 0 && (
      <section>
        <h2 class="text-base font-semibold text-gray-700 mb-2">예상문제 (자체 제작)</h2>
        {config.predictedNote && <p class="text-xs text-gray-400 mb-4 leading-relaxed">{config.predictedNote}</p>}
        <div class="space-y-2">
          {predictedSlugs.map(slug => (
            <a href={examHref(config.slug, 'predicted', slug)} class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:border-sky-300 hover:bg-sky-50 transition-colors group">
              <div>
                <span class="font-medium text-gray-900 group-hover:text-sky-700">{config.shortName} {examTitle('predicted', slug)}</span>
                <span class="text-xs text-gray-400 ml-2">{totalQuestions}문제</span>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <section>
      <h2 class="text-base font-semibold text-gray-700 mb-2">{config.writtenHeading ?? '회차별 기출 시험'}</h2>
      {config.writtenNote && <p class="text-xs text-gray-400 mb-4 leading-relaxed">{config.writtenNote}</p>}
      {examSlugs.length === 0 ? (
        <p class="text-gray-400 text-sm mt-4">등록된 기출문제가 없습니다.</p>
      ) : (
        <div class="space-y-2">
          {examSlugs.map(slug => {
            return (
              <a href={examHref(config.slug, 'written', slug)} class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:border-sky-300 hover:bg-sky-50 transition-colors group">
                <div>
                  <span class="font-medium text-gray-900 group-hover:text-sky-700">{examTitle('written', slug)} {config.shortName}</span>
                  <span class="text-xs text-gray-400 ml-2">{totalQuestions}문제</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      )}
    </section>

    {(examSlugs.length > 0 || predictedSlugs.length > 0) && (
      <section>
        <h2 class="text-base font-semibold text-gray-700 mb-4">실전 모의고사</h2>
        <a href={`/learn/certs/${config.slug}/exam/mock/`} class="flex items-center justify-between p-4 border border-sky-200 bg-sky-50/50 rounded-lg hover:border-sky-300 hover:bg-sky-50 transition-colors group">
          <div>
            <span class="font-medium text-gray-900 group-hover:text-sky-700">{config.shortName} 실전 모의고사</span>
            <span class="text-xs text-gray-400 ml-2">{predictedSlugs.length > 0 ? '예상문제' : '전 회차 기출'}에서 무작위 {totalQuestions}문제</span>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </section>
    )}

  </div>
</BaseLayout>
