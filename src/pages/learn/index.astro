---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const englishPosts = await getCollection('learn', ({ data }) => !data.draft);
const bookCount = englishPosts.length;
---

<BaseLayout
  title="학습 | daparapara"
  description="영어원서 읽기와 정보보안기사 학습 콘텐츠를 모았습니다."
>
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">학습</h1>
    <p class="text-sm text-gray-500">영어원서 읽기 기록과 정보보안기사 학습 자료를 정리합니다.</p>
  </div>

  <section class="mb-10">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">영어원서</h2>
      <span class="text-xs text-gray-400">{bookCount}권</span>
    </div>
    <p class="text-sm text-gray-500 mb-4">AR Level, 핵심 어휘, 줄거리, 리뷰를 함께 정리한 영어원서 읽기 기록입니다.</p>
    <a href="/learn/english/books/" class="text-sm font-medium text-brand-600 hover:underline">영어원서 전체 보기 →</a>
  </section>

  <section>
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">정보보안기사</h2>
    </div>
    <p class="text-sm text-gray-500 mb-4">과목별 이론과 기출문제를 학습할 수 있도록 정리한 정보보안기사 자료입니다.</p>
    <a href="/learn/certs/security/" class="text-sm font-medium text-brand-600 hover:underline">정보보안기사 전체 보기 →</a>
  </section>
</BaseLayout>
