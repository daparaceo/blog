---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const allPosts = await getCollection('learn', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const postsData = posts.map((post) => ({
  slug: post.slug.includes('/') ? post.slug.split('/').pop()! : post.slug,
  title: post.data.title,
  description: post.data.description ?? '',
  author: post.data.author ?? '',
  ar_level: post.data.ar_level ?? null,
  ogImage: post.data.ogImage ?? '',
  date: post.data.publishedAt.toISOString(),
  dateLabel: post.data.publishedAt.toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' }),
}));
---

<BaseLayout
  title="영어원서 | daparapara"
  description="영어원서 읽기 기록 — 어휘, 줄거리, 리뷰를 정리합니다."
>
  <div class="mb-6">
    <nav class="text-xs text-gray-400 mb-3">
      <a href="/learn/" class="hover:text-brand-600">학습</a>
      <span class="mx-1">/</span>
      <span class="text-gray-600">영어원서</span>
    </nav>

    <!-- 제목 + 드롭다운 한 줄 -->
    <div class="flex items-center gap-2 mb-1">
      <h1 class="text-2xl font-bold text-gray-900 mr-auto">영어원서</h1>
      <select
        id="filter-select"
        class="text-xs border border-gray-200 rounded-lg px-2.5 py-1.5 text-gray-600 bg-white outline-none focus:border-brand-400 cursor-pointer"
      >
        <option value="all">전체 AR</option>
        <option value="0-1">AR 0~1</option>
        <option value="1-2">AR 1~2</option>
        <option value="2-3">AR 2~3</option>
        <option value="3-4">AR 3~4</option>
        <option value="4+">AR 4+</option>
      </select>
      <select
        id="sort-select"
        class="text-xs border border-gray-200 rounded-lg px-2.5 py-1.5 text-gray-600 bg-white outline-none focus:border-brand-400 cursor-pointer"
      >
        <option value="date">최신순</option>
        <option value="date_asc">오래된순</option>
        <option value="ar_asc">AR 낮은순</option>
        <option value="ar_desc">AR 높은순</option>
        <option value="title">제목순</option>
        <option value="title_desc">제목역순</option>
      </select>
    </div>

    <!-- 설명 + 카운트 -->
    <div class="flex items-end justify-between">
      <p class="text-gray-500 text-sm">어휘, 줄거리, 독후감을 함께 정리한 영어원서 읽기 기록입니다.</p>
      <span id="post-count" class="text-xs text-gray-400 whitespace-nowrap ml-3 pb-0.5"></span>
    </div>
  </div>

  {posts.length === 0 ? (
    <p class="text-gray-400 text-sm">아직 등록된 글이 없습니다.</p>
  ) : (
    <ul id="book-list" class="divide-y divide-gray-100"></ul>
  )}

  <script is:inline define:vars={{ postsData }}>
    var POSTS = postsData;
    var currentSort   = 'date';
    var currentFilter = 'all';

    function bareTitle(t) {
      return t.replace(/^\[AR[\s\d.]+\]\s*/, '');
    }

    function escHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function filterPosts(posts, key) {
      if (key === 'all') return posts;
      return posts.filter(function(p) {
        var ar = p.ar_level;
        if (ar === null) return false;
        if (key === '0-1') return ar >= 0 && ar < 1;
        if (key === '1-2') return ar >= 1 && ar < 2;
        if (key === '2-3') return ar >= 2 && ar < 3;
        if (key === '3-4') return ar >= 3 && ar < 4;
        if (key === '4+')  return ar >= 4;
        return true;
      });
    }

    function sortPosts(posts, key) {
      var sorted = posts.slice();
      if (key === 'date') {
        sorted.sort(function(a, b) { return b.date < a.date ? -1 : b.date > a.date ? 1 : 0; });
      } else if (key === 'date_asc') {
        sorted.sort(function(a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
      } else if (key === 'ar_asc') {
        sorted.sort(function(a, b) {
          return (a.ar_level !== null ? a.ar_level : 999) - (b.ar_level !== null ? b.ar_level : 999);
        });
      } else if (key === 'ar_desc') {
        sorted.sort(function(a, b) {
          return (b.ar_level !== null ? b.ar_level : -1) - (a.ar_level !== null ? a.ar_level : -1);
        });
      } else if (key === 'title') {
        sorted.sort(function(a, b) { return bareTitle(a.title).localeCompare(bareTitle(b.title), 'ko'); });
      } else if (key === 'title_desc') {
        sorted.sort(function(a, b) { return bareTitle(b.title).localeCompare(bareTitle(a.title), 'ko'); });
      }
      return sorted;
    }

    function renderList() {
      var filtered = filterPosts(POSTS, currentFilter);
      var sorted   = sortPosts(filtered, currentSort);

      var countEl = document.getElementById('post-count');
      if (countEl) {
        countEl.textContent = currentFilter === 'all'
          ? POSTS.length + '권'
          : sorted.length + ' / ' + POSTS.length + '권';
      }

      var ul = document.getElementById('book-list');
      if (!ul) return;

      if (sorted.length === 0) {
        ul.innerHTML = '<li class="py-8 text-center text-sm text-gray-400">해당 AR 범위의 책이 없습니다.</li>';
        return;
      }

      ul.innerHTML = sorted.map(function(p) {
        var meta = '';
        if (p.author || p.ar_level !== null) {
          var parts = [];
          if (p.author) parts.push('<span>' + escHtml(p.author) + '</span>');
          if (p.ar_level !== null) parts.push('<span>AR ' + p.ar_level + '</span>');
          meta = '<p class="text-xs text-gray-400 mt-1">' + parts.join('<span class="mx-1">·</span>') + '</p>';
        }
        var desc = p.description
          ? '<p class="text-gray-500 text-sm mt-0.5 line-clamp-1">' + escHtml(p.description) + '</p>'
          : '';
        var cover = p.ogImage
          ? '<img src="' + escHtml(p.ogImage) + '" alt="" loading="lazy" class="w-14 h-20 flex-shrink-0 rounded-md object-cover shadow-sm bg-gray-100">'
          : '';
        return (
          '<li class="py-4 group">' +
            '<a href="/learn/english/books/' + p.slug + '/" class="flex items-start gap-3 sm:gap-4">' +
              cover +
              '<div class="flex-1 min-w-0">' +
                '<span class="text-base font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">' +
                  escHtml(p.title) +
                '</span>' +
                desc +
                meta +
              '</div>' +
              '<time class="text-xs text-gray-400 whitespace-nowrap mt-1 ml-auto">' + p.dateLabel + '</time>' +
            '</a>' +
          '</li>'
        );
      }).join('');
    }

    document.getElementById('filter-select').addEventListener('change', function() {
      currentFilter = this.value;
      renderList();
    });

    document.getElementById('sort-select').addEventListener('change', function() {
      currentSort = this.value;
      renderList();
    });

    renderList();
  </script>
</BaseLayout>
