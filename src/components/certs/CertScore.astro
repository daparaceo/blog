---
// 전체 채점 결과: 총점·과목별 점수·합격 판정. 페이지에서 window.certScore.show(문항 요소 목록)으로 호출한다.
// 과목별 과락 기준(subjectPassScore)이 있는 시험만 과락 판정을 한다.
interface Props {
  passScore: number;
  subjectPassScore?: number;
}

const { passScore, subjectPassScore } = Astro.props;
---

<div id="score-section" class="hidden border border-indigo-200 bg-indigo-50 rounded-lg p-4" data-pass-score={passScore} data-subject-pass-score={subjectPassScore ?? ''}>
  <p class="text-indigo-700 font-semibold text-lg" id="score-display"></p>
  <p class="text-indigo-500 text-sm mt-1" id="score-detail"></p>
  <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-sm" id="score-subjects"></ul>
</div>

<script>
  type Row = { subject: string; correct: number; total: number; score: number };

  function show(items: HTMLElement[], isCorrect: (item: HTMLElement) => boolean) {
    const section = document.getElementById('score-section')!;
    const passScore = Number(section.dataset.passScore);
    const subjectPassScore = section.dataset.subjectPassScore ? Number(section.dataset.subjectPassScore) : null;

    const bySubject = new Map<string, Row>();
    let correct = 0;
    items.forEach(item => {
      const subject = item.dataset.subject ?? '';
      if (!bySubject.has(subject)) bySubject.set(subject, { subject, correct: 0, total: 0, score: 0 });
      const row = bySubject.get(subject)!;
      row.total++;
      if (isCorrect(item)) { row.correct++; correct++; }
    });
    const rows = Array.from(bySubject.values());
    rows.forEach(r => { r.score = Math.round((r.correct / r.total) * 100); });

    const score = Math.round((correct / items.length) * 100);
    const failed = subjectPassScore === null ? [] : rows.filter(r => r.score < subjectPassScore);

    document.getElementById('score-display')!.textContent = `${correct} / ${items.length}문제 (${score}점)`;
    let verdict: string;
    if (failed.length > 0) verdict = `불합격 — 과락 ${failed.map(r => r.subject).join(', ')} (과목별 ${subjectPassScore}점 미만)`;
    else if (score < passScore) verdict = `불합격 (${passScore}점 미만)`;
    else verdict = subjectPassScore === null
      ? `합격 기준 충족 (${passScore}점 이상)`
      : `합격 기준 충족 (${passScore}점 이상, 전 과목 ${subjectPassScore}점 이상)`;
    document.getElementById('score-detail')!.textContent = verdict;

    const list = document.getElementById('score-subjects')!;
    list.innerHTML = '';
    rows.forEach(r => {
      const fail = subjectPassScore !== null && r.score < subjectPassScore;
      const li = document.createElement('li');
      li.className = `flex justify-between ${fail ? 'text-red-600 font-medium' : 'text-indigo-600'}`;
      const name = document.createElement('span');
      name.textContent = r.subject + (fail ? ' (과락)' : '');
      const value = document.createElement('span');
      value.textContent = `${r.correct}/${r.total} · ${r.score}점`;
      li.append(name, value);
      list.appendChild(li);
    });

    section.classList.remove('hidden');
    section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hide() {
    document.getElementById('score-section')?.classList.add('hidden');
  }

  (window as any).certScore = { show, hide };
</script>
