---
// 도서 검색 박스 — 제목/저자/ISBN으로 검색 → 후보 선택 → 이미 리뷰 있으면 링크,
// 없으면(영어 원서) "교육자료 만들기"로 생성 요청.
// search.astro의 도서 검색 기능(스캐너·Pagefind 전체 검색 제외)만 분리한 버전.
// 여러 페이지에 반복 삽입되므로 id 충돌을 피하려고 슬롯 id에 접두어를 붙인다.
import { getCollection } from 'astro:content';

interface Props {
  idPrefix?: string;
}
const { idPrefix = 'bsb' } = Astro.props;

const posts = await getCollection('learn', ({ data }) => !data.draft);
const isbnPostMap: Record<string, { slug: string; title: string; ogImage: string }> = {};
for (const post of posts) {
  const addEntry = (isbn: string) => {
    const clean = isbn.replace(/\D/g, '');
    if (clean.length >= 10 && !isbnPostMap[clean]) {
      isbnPostMap[clean] = {
        slug: post.slug.includes('/') ? post.slug.split('/').pop()! : post.slug,
        title: post.data.title,
        ogImage: post.data.ogImage ?? '',
      };
    }
  };
  if (post.data.isbn) addEntry(String(post.data.isbn));
  const filename = post.slug.split('/').pop() ?? '';
  const m = filename.match(/_(97[89]\d{10})$/);
  if (m) addEntry(m[1]);
}
---

<div class="book-search-box" data-id-prefix={idPrefix}>
  <div class="flex gap-2">
    <input id={`${idPrefix}-query`} type="text" placeholder="Harry Potter / J.K. Rowling / 9780439708180"
      class="flex-1 min-w-0 px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:outline-none focus:border-sky-400 transition-colors bg-white" />
    <button type="button" class={`${idPrefix}-js-search-btn px-4 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-xl hover:bg-gray-200 active:scale-95 transition-all`}>
      검색
    </button>
  </div>

  <div id={`${idPrefix}-candidates`} class="hidden mt-2 space-y-2"></div>
  <button id={`${idPrefix}-more-search`}
    class="hidden mt-2 w-full py-2 text-sm text-sky-600 border border-sky-200 rounded-xl hover:bg-sky-50 transition-colors">
    추가 검색
  </button>
  <div id={`${idPrefix}-info-card`} class="hidden mt-3"></div>
  <input id={`${idPrefix}-isbn`} type="hidden" />

  <p id={`${idPrefix}-error`} class="hidden mt-3 text-sm text-red-500"></p>
</div>

<script define:vars={{ isbnPostMap, idPrefix }}>
  (function () {
    var API = 'https://api.daparapara.com';
    var ISBN_MAP = isbnPostMap || {};
    var P = idPrefix;
    var _currentIsbn = null;
    var _pollTimer = null;
    var _pollErrorCount = 0;
    var _lastQuery = '';
    var _lastPage = 0;
    var _shownIsbns = new Set();
    var _searchSeq = 0;
    var POLL_INTERVAL = 10000;
    var POLL_TIMEOUT = 300000;

    function el(id) { return document.getElementById(P + '-' + id); }

    function isValidIsbn13(value) {
      var d = String(value || '').replace(/\D/g, '');
      if (!/^97[89]\d{10}$/.test(d)) return false;
      var sum = 0;
      for (var i = 0; i < 12; i++) sum += parseInt(d[i]) * (i % 2 === 0 ? 1 : 3);
      return ((10 - sum % 10) % 10) === parseInt(d[12]);
    }

    function normalizeIsbn(raw) {
      var d = String(raw || '').replace(/\D/g, '');
      if (d.length === 13 && /^97[89]/.test(d)) return d;
      if (d.length > 13 && /^97[89]/.test(d) && isValidIsbn13(d.slice(0, 13))) return d.slice(0, 13);
      if (d.length === 14 && /^97[89]/.test(d)) {
        var b12 = d.slice(0, 12), s = 0;
        for (var i = 0; i < 12; i++) s += parseInt(b12[i]) * (i % 2 === 0 ? 1 : 3);
        return b12 + ((10 - s % 10) % 10);
      }
      if (d.length === 15 && /^97[89]/.test(d)) return d.slice(0, 13);
      if (d.length === 10) {
        var base = '978' + d.slice(0, 9), s2 = 0;
        for (var j = 0; j < 12; j++) s2 += parseInt(base[j]) * (j % 2 === 0 ? 1 : 3);
        return base + ((10 - s2 % 10) % 10);
      }
      return d;
    }

    function arBadgeHtml(ar) {
      if (!ar) return '';
      var n = parseFloat(ar);
      var cls = isNaN(n) ? 'bg-gray-100 text-gray-600'
               : n < 1.0 ? 'bg-purple-100 text-purple-700'
               : n < 3.5 ? 'bg-sky-100 text-sky-700'
               :            'bg-amber-100 text-amber-700';
      return '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ' +
             cls + '">AR ' + ar + '</span>';
    }

    function bookMetaHtml(isbn, ar) {
      var clean = (isbn || '').toString().replace(/\D/g, '');
      var isbnHtml = clean ? '<span class="text-xs text-gray-400">ISBN ' + clean + '</span>' : '';
      var arHtml = arBadgeHtml(ar);
      if (!isbnHtml && !arHtml) return '';
      return '<div class="mt-1 flex flex-wrap items-center gap-1.5">' + isbnHtml + arHtml + '</div>';
    }

    function resetSearchResults() {
      _lastPage = 0;
      _shownIsbns.clear();
      _currentIsbn = null;
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

      el('candidates').innerHTML = '';
      el('candidates').classList.add('hidden');
      el('more-search').classList.add('hidden');
      el('info-card').classList.add('hidden');
      el('error').classList.add('hidden');
    }

    function buildSearchQueries(q) {
      var queries = [q];
      var cleaned = q
        .replace(/\s*\(\s*by\s+[^)]*\)\s*/gi, ' ')
        .replace(/\s+by\s+[A-Za-z .,'-]+$/i, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (cleaned && cleaned.toLowerCase() !== q.toLowerCase()) {
        queries.push(cleaned);
      }

      return queries.filter(function(query, index) {
        return query && queries.findIndex(function(item) {
          return item.toLowerCase() === query.toLowerCase();
        }) === index;
      });
    }

    async function fetchSearchResults(queries, size, page) {
      var lastData = { results: [] };

      for (var i = 0; i < queries.length; i++) {
        var query = queries[i];
        var langParam = /[가-힣]/.test(query) ? '' : '&lang=en';
        var res = await fetch(
          API + '/book-search?q=' + encodeURIComponent(query) +
          '&size=' + size + langParam + '&page=' + page
        );
        if (!res.ok) throw new Error('검색 실패 (' + res.status + ')');

        var data = await res.json();
        lastData = data;
        if ((data.results || []).length || i === queries.length - 1) {
          return { query: query, data: data };
        }
      }

      return { query: queries[0], data: lastData };
    }

    async function searchByTitle(extended) {
      var inputEl = el('query');
      var q = extended ? _lastQuery : inputEl.value.trim();
      if (!q || q.length < 2) return;
      var searchSeq = ++_searchSeq;

      var listEl = el('candidates');
      var moreBtn = el('more-search');
      var errEl = el('error');

      if (!extended) {
        resetSearchResults();
        _lastQuery = q;
      } else {
        _lastPage++;
      }

      var digits = normalizeIsbn(q);
      if (digits.length === 10 || digits.length === 13) {
        el('isbn').value = digits;
        lookupIsbn();
        return;
      }

      var size = 5;
      errEl.classList.add('hidden');
      moreBtn.classList.add('hidden');

      if (!extended) {
        listEl.innerHTML = '<p class="text-sm text-center text-gray-400 py-3">검색 중...</p>';
        listEl.classList.remove('hidden');
      } else {
        listEl.insertAdjacentHTML('beforeend',
          '<p class="' + P + '-more-loading text-sm text-center text-gray-400 py-3">검색 중...</p>');
      }

      try {
        var searchResult = await fetchSearchResults(
          extended ? [_lastQuery] : buildSearchQueries(q),
          size,
          _lastPage
        );
        if (searchSeq !== _searchSeq) return;
        var data = searchResult.data;
        var results = data.results || [];
        _lastQuery = searchResult.query;

        var loadingEl = document.querySelector('.' + P + '-more-loading');
        if (loadingEl) loadingEl.remove();

        if (!results.length) {
          if (!extended) {
            listEl.innerHTML = '<p class="text-sm text-center text-gray-500 py-3">결과가 없어요. 영어로 검색해보세요.</p>';
          } else {
            listEl.insertAdjacentHTML('beforeend',
              '<p class="text-sm text-center text-gray-500 py-3">더 이상 결과가 없어요.</p>');
          }
          return;
        }

        var filtered = results.filter(function(item) {
          if (_shownIsbns.has(item.isbn)) return false;
          _shownIsbns.add(item.isbn);
          return true;
        });
        var html = filtered.map(function(item) {
          return '<div class="book-candidate bg-white border border-gray-200 rounded-xl overflow-hidden transition-colors" ' +
            'data-book-isbn="' + item.isbn.replace(/\D/g, '') + '">' +
            '<button type="button" class="' + P + '-js-select book-candidate-button w-full text-left p-3 hover:bg-sky-50 transition-colors" ' +
            'data-item="' + JSON.stringify(item).replace(/"/g, '&quot;') + '">' +
            '<div class="flex items-start gap-3">' +
            (item.cover_url
              ? '<img src="' + item.cover_url + '" class="w-10 h-14 object-cover rounded flex-shrink-0" onerror="this.style.display=\'none\'">'
              : '') +
            '<div class="flex-1 min-w-0">' +
            '<p class="text-sm font-semibold text-gray-900 leading-snug line-clamp-2">' + (item.title || '(제목 없음)') + '</p>' +
            (item.author ? '<p class="text-xs text-gray-500 mt-0.5">' + item.author + '</p>' : '') +
            bookMetaHtml(item.isbn, item.ar_level) +
            '</div></div></button>' +
            '<div class="book-candidate-detail hidden px-3 pb-3"></div></div>';
        }).join('');

        if (!extended) {
          listEl.innerHTML = html;
        } else if (html) {
          listEl.insertAdjacentHTML('beforeend', html);
        } else {
          listEl.insertAdjacentHTML('beforeend',
            '<p class="text-sm text-center text-gray-500 py-3">더 이상 새로운 결과가 없어요.</p>');
        }

        moreBtn.classList.toggle('hidden', filtered.length === 0 || results.length < size);
      } catch (e) {
        if (searchSeq !== _searchSeq) return;
        var loadingEl2 = document.querySelector('.' + P + '-more-loading');
        if (loadingEl2) loadingEl2.remove();
        if (!extended) {
          listEl.innerHTML = '<p class="text-sm text-center text-red-400 py-3">검색 오류: ' + e.message + '</p>';
        } else {
          listEl.insertAdjacentHTML('beforeend',
            '<p class="text-sm text-center text-red-400 py-3">검색 오류: ' + e.message + '</p>');
        }
      }
    }

    function selectCandidate(item) {
      if (!item.isbn) return;

      var cleanIsbn = item.isbn.replace(/\D/g, '');
      _currentIsbn = cleanIsbn;
      el('isbn').value = cleanIsbn;
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

      var post = ISBN_MAP[cleanIsbn] || ISBN_MAP[item.isbn];
      var canCreatePost = item.language !== 'ko';
      var ctaHtml = post
        ? '<a href="/learn/english/books/' + post.slug + '/" target="_blank" ' +
          'class="block mt-3 w-full py-2.5 bg-emerald-600 text-white text-sm font-semibold text-center rounded-xl hover:bg-emerald-700 active:scale-95 transition-all">포스트 보러가기</a>'
        : !canCreatePost
          ? '<p class="mt-3 text-xs text-gray-400 text-center">영어 원서만 교육자료 생성을 지원합니다.</p>'
        : '<button type="button" class="' + P + '-js-post-btn js-book-post-button mt-3 w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">교육자료 만들기</button>' +
          '<p class="js-book-post-note hidden mt-2 text-xs text-gray-400 text-center">교육자료 생성까지 평균 3~4분, 최대 5분 소요됩니다.</p>';

      var standaloneCard = el('info-card');
      standaloneCard.classList.add('hidden');
      document.querySelectorAll('#' + P + '-candidates .book-candidate-detail').forEach(function(detail) {
        detail.classList.add('hidden');
        detail.innerHTML = '';
      });
      document.querySelectorAll('#' + P + '-candidates .book-candidate').forEach(function(candidate) {
        candidate.classList.remove('border-sky-400', 'bg-sky-50');
      });
      var candidateEl = document.querySelector('#' + P + '-candidates [data-book-isbn="' + cleanIsbn + '"]');
      var cardEl = candidateEl ? candidateEl.querySelector('.book-candidate-detail') : standaloneCard;
      if (candidateEl) {
        candidateEl.classList.add('border-sky-400', 'bg-sky-50');
      }
      el('error').classList.add('hidden');
      cardEl.innerHTML = ctaHtml;
      cardEl.classList.remove('hidden');
    }

    async function lookupIsbn() {
      var isbn = el('isbn').value.trim().replace(/\D/g, '');
      var errEl = el('error');
      var cardEl = el('info-card');

      el('query').value = isbn;
      errEl.classList.add('hidden');
      cardEl.classList.add('hidden');
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }

      if (!isbn || !/^\d{10,13}$/.test(isbn)) {
        errEl.textContent = 'ISBN은 10~13자리 숫자여야 합니다.';
        errEl.classList.remove('hidden');
        return;
      }

      _currentIsbn = null;
      cardEl.innerHTML = '<div class="p-4 bg-gray-50 rounded-xl text-sm text-gray-400 text-center">도서 정보 조회 중...</div>';
      cardEl.classList.remove('hidden');

      try {
        var res = await fetch(API + '/book-search?isbn=' + isbn);
        if (!res.ok) {
          var body = await res.json().catch(function() { return {}; });
          throw new Error(body.error || '도서 정보를 찾을 수 없습니다.');
        }
        var book = await res.json();
        _currentIsbn = book.isbn || isbn;
        cardEl.innerHTML = buildBookCard(book);
        cardEl.classList.remove('hidden');
      } catch (e) {
        cardEl.classList.add('hidden');
        errEl.textContent = e.message;
        errEl.classList.remove('hidden');
      }
    }

    function buildBookCard(book) {
      var post = ISBN_MAP[book.isbn] || ISBN_MAP[(book.isbn || '').replace(/\D/g, '')];
      var canCreatePost = book.language !== 'ko';
      var ctaHtml = post
        ? '<a href="/learn/english/books/' + post.slug + '/" target="_blank" ' +
          'class="inline-block mt-3 px-4 py-1.5 bg-emerald-600 text-white text-xs font-semibold rounded-lg hover:bg-emerald-700 active:scale-95 transition-all">리뷰 보기</a>'
        : !canCreatePost
          ? '<p class="mt-3 text-xs text-gray-400 text-center">영어 원서만 교육자료 생성을 지원합니다.</p>'
        : '<button type="button" class="' + P + '-js-post-btn js-book-post-button mt-3 w-full py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl hover:bg-sky-700 active:scale-95 transition-all">교육자료 만들기</button>' +
          '<p class="js-book-post-note hidden mt-2 text-xs text-gray-400 text-center">교육자료 생성까지 평균 3~4분, 최대 5분 소요됩니다.</p>';

      return '<div class="p-4 bg-white border border-gray-200 rounded-xl">' +
        '<div class="flex gap-3">' +
        (book.cover
          ? '<img src="' + book.cover + '" alt="표지" class="w-14 h-20 object-cover rounded-lg shadow-sm flex-shrink-0" onerror="this.style.display=\'none\'">'
          : '') +
        '<div class="flex-1 min-w-0">' +
        (post ? '<p class="text-xs font-semibold text-emerald-600 mb-0.5">리뷰 있음</p>' : '') +
        '<p class="font-semibold text-gray-900 text-sm leading-snug">' + (book.title || '') + '</p>' +
        (book.author ? '<p class="text-xs text-gray-500 mt-0.5">' + book.author + '</p>' : '') +
        (book.series ? '<p class="text-xs text-gray-400 mt-0.5">' + book.series + '</p>' : '') +
        bookMetaHtml(book.isbn, book.ar_level) +
        '</div></div>' +
        ctaHtml +
        '</div>';
    }

    function setPostButtonState(label, disabled) {
      document.querySelectorAll('#' + P + '-candidates .js-book-post-button, #' + P + '-info-card .js-book-post-button').forEach(function(btn) {
        btn.textContent = label;
        btn.disabled = !!disabled;
        btn.classList.toggle('opacity-70', !!disabled);
        btn.classList.toggle('cursor-not-allowed', !!disabled);
      });
    }

    function setPostNoteVisible(visible) {
      document.querySelectorAll('#' + P + '-candidates .js-book-post-note, #' + P + '-info-card .js-book-post-note').forEach(function(note) {
        note.classList.toggle('hidden', !visible);
      });
    }

    function updatePostProgress(elapsed) {
      var label = '교육자료 요청 중입니다. (' + elapsed + '초)';
      setPostButtonState(label, true);
      setPostNoteVisible(true);
    }

    // 방금 완료된 포스트는 GitHub Pages 빌드/배포가 아직 안 끝났을 수 있어
    // 클릭 시 먼저 살아있는지 확인하고, 아직이면 안내만 띄운다 (404 예방)
    function openLiveLink(url) {
      fetch(url, { method: 'HEAD' })
        .then(function(res) {
          if (res.ok) {
            window.open(url, '_blank');
          } else {
            alert('아직 배포 중입니다. 1~2분 후 다시 눌러주세요.');
          }
        })
        .catch(function() {
          window.open(url, '_blank');
        });
    }

    function showPostResult(data) {
      setPostNoteVisible(false);
      document.querySelectorAll('#' + P + '-candidates .js-book-post-button, #' + P + '-info-card .js-book-post-button').forEach(function(btn) {
        btn.classList.remove('opacity-70', 'cursor-not-allowed', 'bg-sky-600', 'hover:bg-sky-700');
        if (data && data.post_url) {
          btn.textContent = '포스트 보러가기';
          btn.disabled = false;
          btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
          btn.onclick = function() { openLiveLink(data.post_url); };
        } else {
          btn.textContent = '교육자료 생성 완료';
          btn.disabled = true;
          btn.classList.add('opacity-70', 'cursor-not-allowed', 'bg-sky-600');
        }
      });
    }

    function showPostError(message) {
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
      var errEl = el('error');
      errEl.textContent = message || '교육자료 생성이 보류되었습니다. 잠시 후 다시 시도해주세요.';
      errEl.classList.remove('hidden');
      setPostButtonState('교육자료 만들기', false);
      setPostNoteVisible(false);
    }

    async function pollPostStatus(startedAt, deadline) {
      var elapsed = Math.round((Date.now() - startedAt) / 1000);
      updatePostProgress(elapsed);

      var res;
      var data;
      try {
        res = await fetch(API + '/book-status?isbn=' + _currentIsbn);
        data = await res.json().catch(function() { return {}; });
      } catch (_) {
        _pollErrorCount++;
        if (_pollErrorCount < 3) return false;
        throw new Error('교육자료 요청은 등록됐지만 상태 확인 연결이 불안정합니다. 잠시 후 다시 확인해주세요.');
      }
      if (!res.ok) {
        _pollErrorCount++;
        if (_pollErrorCount < 3) return false;
        throw new Error(data.error || '포스트 상태를 확인할 수 없습니다.');
      }
      _pollErrorCount = 0;

      if (data.status === 'completed' || data.display_status === 'posted') {
        if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
        showPostResult(data);
        return true;
      }

      if (data.display_status === 'failed' || data.display_status === 'cancelled') {
        if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
        showPostError('자료가 부족해서 교육자료 생성에 실패했습니다.');
        return true;
      }

      if (Date.now() >= deadline) {
        if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
        showPostError('교육자료 생성 요청은 등록됐지만 5분 안에 완료되지 않았습니다. 잠시 후 다시 확인해주세요.');
        return true;
      }
      return false;
    }

    async function startPostPolling() {
      if (!_currentIsbn) return;
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
      el('error').classList.add('hidden');
      updatePostProgress(0);
      _pollErrorCount = 0;

      var startedAt = Date.now();
      var deadline = Date.now() + POLL_TIMEOUT;

      try {
        var req = await fetch(API + '/post-request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ isbn: _currentIsbn }),
        });
        var body = await req.json().catch(function() { return {}; });
        if (!req.ok) throw new Error(body.error || '교육자료 생성 요청에 실패했습니다.');

        if (body.status === 'completed' || body.display_status === 'posted') {
          showPostResult(body);
          return;
        }

        updatePostProgress(Math.round((Date.now() - startedAt) / 1000));
        var finished = await pollPostStatus(startedAt, deadline);
        if (!finished && !_pollTimer) {
          _pollTimer = setInterval(function() {
            pollPostStatus(startedAt, deadline).catch(function(e) {
              showPostError(e.message);
            });
          }, POLL_INTERVAL);
        }
      } catch (e) {
        showPostError(e && e.message === 'Failed to fetch'
          ? '교육자료 요청 API에 연결하지 못했습니다. 잠시 후 다시 시도해주세요.'
          : e.message);
      }
    }

    // 이벤트 위임 — id 접두어별로 스코프를 나눠서 여러 인스턴스가 한 페이지에 있어도 안전
    document.querySelectorAll('.' + P + '-js-search-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { searchByTitle(false); });
    });
    el('more-search').addEventListener('click', function() { searchByTitle(true); });
    el('query').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') searchByTitle(false);
    });
    document.addEventListener('click', function(e) {
      var selectBtn = e.target.closest('.' + P + '-js-select');
      if (selectBtn) {
        selectCandidate(JSON.parse(selectBtn.getAttribute('data-item').replace(/&quot;/g, '"')));
        return;
      }
      var postBtn = e.target.closest('.' + P + '-js-post-btn');
      if (postBtn) startPostPolling();
    });
  })();
</script>
