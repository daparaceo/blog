<div class="mt-10 flex justify-end" data-pagefind-ignore>
  <button id="error-report-open" type="button"
    class="text-xs text-gray-400 hover:text-gray-600 underline underline-offset-2">
    글에 오류가 있나요? 신고하기
  </button>
</div>

<dialog id="error-report-dialog" aria-labelledby="error-report-heading" data-pagefind-ignore
  class="w-[calc(100%-2rem)] max-w-md rounded-xl p-0 shadow-xl backdrop:bg-black/40">
  <form id="error-report-form" class="p-5 space-y-4" novalidate>
    <div class="flex items-center justify-between">
      <h2 id="error-report-heading" class="text-base font-bold text-gray-900">오류 신고</h2>
      <button type="button" data-close class="w-8 h-8 -mr-2 rounded-lg text-gray-400 hover:bg-gray-100" aria-label="닫기">&times;</button>
    </div>

    <fieldset>
      <legend class="text-sm font-medium text-gray-700 mb-2">어떤 문제인가요?</legend>
      <div class="grid grid-cols-2 gap-2 text-sm">
        <label class="flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer has-[:checked]:border-sky-400 has-[:checked]:bg-sky-50">
          <input type="radio" name="report_type" value="typo" checked /> 오타
        </label>
        <label class="flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer has-[:checked]:border-sky-400 has-[:checked]:bg-sky-50">
          <input type="radio" name="report_type" value="wrong_info" /> 잘못된 정보
        </label>
        <label class="flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer has-[:checked]:border-sky-400 has-[:checked]:bg-sky-50">
          <input type="radio" name="report_type" value="broken" /> 이미지·링크 깨짐
        </label>
        <label class="flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer has-[:checked]:border-sky-400 has-[:checked]:bg-sky-50">
          <input type="radio" name="report_type" value="other" /> 기타
        </label>
      </div>
    </fieldset>

    <div id="error-report-quote-wrap" class="hidden">
      <div class="flex items-center justify-between mb-1">
        <span class="text-sm font-medium text-gray-700">선택한 문장</span>
        <button type="button" id="error-report-quote-clear" class="text-xs text-gray-400 hover:text-gray-600">빼기</button>
      </div>
      <blockquote id="error-report-quote" class="text-sm text-gray-600 bg-gray-50 border-l-2 border-gray-300 px-3 py-2 rounded break-words"></blockquote>
    </div>

    <div>
      <label for="error-report-message" class="block text-sm font-medium text-gray-700 mb-1">내용</label>
      <textarea id="error-report-message" name="message" rows="4" required minlength="5" maxlength="1000"
        placeholder="어디가 어떻게 잘못됐는지 알려주세요."
        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-sky-400 resize-y"></textarea>
      <p class="text-xs text-gray-400 mt-1">본문에서 문장을 드래그한 뒤 신고하면 함께 첨부됩니다.</p>
    </div>

    <!-- 허니팟: 사람에게는 보이지 않는 칸. 봇이 채우면 서버가 조용히 버린다. -->
    <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
      <label>웹사이트 <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p id="error-report-status" role="status" class="text-sm min-h-[1.25rem]"></p>

    <div class="flex justify-end gap-2">
      <button type="button" data-close class="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">취소</button>
      <button type="submit" id="error-report-submit" class="px-4 py-2 text-sm font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 disabled:opacity-50">보내기</button>
    </div>
  </form>
</dialog>

<script>
  const api = import.meta.env.PUBLIC_DICTIONARY_API_BASE || 'https://api.daparapara.com';
  const openButton = document.querySelector<HTMLButtonElement>('#error-report-open');
  const dialog = document.querySelector<HTMLDialogElement>('#error-report-dialog');
  const form = document.querySelector<HTMLFormElement>('#error-report-form');
  const message = document.querySelector<HTMLTextAreaElement>('#error-report-message');
  const quoteWrap = document.querySelector<HTMLElement>('#error-report-quote-wrap');
  const quoteBox = document.querySelector<HTMLElement>('#error-report-quote');
  const status = document.querySelector<HTMLElement>('#error-report-status');
  const submit = document.querySelector<HTMLButtonElement>('#error-report-submit');
  let lastSelection = '';
  let quote = '';

  // 버튼을 누르면 선택이 풀리므로, 본문에서 마지막으로 선택한 문장을 미리 기억해 둔다.
  document.addEventListener('selectionchange', () => {
    const selection = document.getSelection();
    const text = selection?.toString().replace(/\s+/g, ' ').trim() ?? '';
    if (!text) return;
    const node = selection?.anchorNode;
    const element = node instanceof Element ? node : node?.parentElement;
    if (!element?.closest('main') || element.closest('#error-report-dialog')) return;
    lastSelection = text.slice(0, 300);
  });

  function setStatus(text: string, tone: 'error' | 'ok' | 'muted' = 'muted') {
    if (!status) return;
    status.textContent = text;
    status.className = 'text-sm min-h-[1.25rem] ' + { error: 'text-red-600', ok: 'text-green-700', muted: 'text-gray-500' }[tone];
  }

  function showQuote(text: string) {
    quote = text;
    if (quoteBox) quoteBox.textContent = text;
    quoteWrap?.classList.toggle('hidden', !text);
  }

  openButton?.addEventListener('click', () => {
    if (!dialog || !form) return;
    form.reset();
    setStatus('');
    if (submit) { submit.disabled = false; submit.textContent = '보내기'; }
    showQuote(lastSelection);
    dialog.showModal();
    message?.focus();
  });

  document.querySelector('#error-report-quote-clear')?.addEventListener('click', () => showQuote(''));
  dialog?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => dialog.close()));
  // 바깥(배경) 클릭 시 닫기
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message || !submit) return;
    const text = message.value.trim();
    if (text.length < 5) { setStatus('내용을 5자 이상 적어주세요.', 'error'); message.focus(); return; }
    const data = new FormData(form);
    submit.disabled = true;
    setStatus('보내는 중입니다.');
    try {
      const response = await fetch(`${api}/error-report`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page_path: location.pathname,
          page_title: document.title.slice(0, 200),
          report_type: data.get('report_type'),
          message: text,
          quote: quote || undefined,
          website: data.get('website') || undefined,
        }),
        signal: AbortSignal.timeout(15000),
      });
      if (response.status === 202) {
        setStatus('신고가 접수되었습니다. 알려주셔서 감사합니다.', 'ok');
        submit.textContent = '완료';
        lastSelection = '';
        window.setTimeout(() => dialog?.close(), 1500);
        return;
      }
      setStatus(response.status === 429 ? '신고가 너무 많습니다. 잠시 후 다시 시도해 주세요.' : '접수하지 못했습니다. 잠시 후 다시 시도해 주세요.', 'error');
    } catch {
      setStatus('네트워크 오류로 접수하지 못했습니다.', 'error');
    }
    submit.disabled = false;
  });
</script>
