<section class="mt-12 pt-8 border-t border-gray-100" aria-labelledby="word-search-heading" data-pagefind-ignore>
  <h3 id="word-search-heading" class="text-lg font-bold text-gray-800 mb-4">궁금한 단어를 검색해보세요</h3>
  <form id="word-search-form" class="flex gap-2" role="search">
    <label for="word-search-query" class="sr-only">영어 단어 또는 표현</label>
    <input id="word-search-query" type="search" required maxlength="100" placeholder="영어 단어 또는 표현" autocomplete="off" spellcheck="false"
      class="flex-1 min-w-0 px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-sky-400 bg-white" />
    <button type="submit" class="shrink-0 px-4 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200">검색</button>
  </form>
  <p id="word-search-status" role="status" class="mt-3 text-sm text-gray-500"></p>
  <div id="word-search-result" class="space-y-3 text-sm break-words" aria-busy="false"></div>
</section>

<script>
  import { createElement, Volume2 } from 'lucide';
  const form = document.querySelector<HTMLFormElement>('#word-search-form');
  const input = document.querySelector<HTMLInputElement>('#word-search-query');
  const status = document.querySelector<HTMLElement>('#word-search-status');
  const result = document.querySelector<HTMLElement>('#word-search-result');
  let request: AbortController | undefined;
  let audio: HTMLAudioElement | undefined;
  let revision = 0;
  let translationRequest: AbortController | undefined;
  const dictionaryApi = import.meta.env.PUBLIC_DICTIONARY_API_BASE || 'https://api.daparapara.com';

  function addText(parent: HTMLElement, tag: string, text: string, className = '') {
    const element = document.createElement(tag);
    element.textContent = text;
    element.className = className;
    parent.append(element);
    return element;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!input || !status || !result) return;
    const word = input.value.trim().replace(/\s+/g, ' ');
    if (!word) { input.focus(); return; }
    request?.abort();
    translationRequest?.abort();
    audio?.pause();
    const current = ++revision;
    const controller = new AbortController();
    request = controller;
    const timeout = window.setTimeout(() => controller.abort(), 22000);
    result.replaceChildren();
    result.setAttribute('aria-busy', 'true');
    status.textContent = '단어를 찾고 있습니다.';
    let hasLocal = false;

    const heading = addText(result, 'div', '', 'flex flex-wrap items-center gap-3');
    addText(heading, 'strong', word, 'text-base');
    const play = document.createElement('button');
    play.type = 'button';
    play.setAttribute('aria-label', '발음 듣기');
    play.title = '발음 듣기';
    play.append(createElement(Volume2, { width: 20, height: 20, 'aria-hidden': 'true' }));
    play.className = 'inline-flex items-center justify-center w-9 h-9 rounded-lg text-sky-700 hover:bg-sky-50 disabled:opacity-50';
    heading.append(play);
    const tablist = addText(result, 'div', '', 'flex gap-4 border-b border-gray-200');
    tablist.setAttribute('role', 'tablist');
    tablist.setAttribute('aria-label', '설명 언어');
    const panels = { ko: addText(result, 'div', '', 'space-y-3'), en: addText(result, 'div', '', 'space-y-3') };
    const tabs: HTMLButtonElement[] = [];
    let englishReady = false;
    let translated = false;
    let translating = false;
    let dictionaryEntry: { id: string; content_hash: string } | undefined;
    const selectLanguage = (language: 'ko' | 'en') => {
      for (const button of tabs) {
        const active = button.dataset.language === language;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        button.className = `pb-2 text-sm border-b-2 ${active ? 'border-sky-600 text-sky-700 font-semibold' : 'border-transparent text-gray-500'}`;
      }
      panels.ko.hidden = language !== 'ko';
      panels.en.hidden = language !== 'en';
      if (language === 'ko' && !hasLocal && englishReady && !translated && !translating) void translateKorean();
    };
    const translateKorean = async () => {
      translating = true;
      panels.ko.replaceChildren();
      panels.ko.setAttribute('aria-busy', 'true');
      addText(panels.ko, 'p', '한국어로 번역하고 있습니다.', 'text-gray-500');
      const translationController = new AbortController();
      translationRequest = translationController;
      const translationTimeout = window.setTimeout(() => translationController.abort(), 30000);
      try {
        if (!dictionaryEntry) throw new Error('disabled');
        let content: { partOfSpeech: string; definitions: { definition: string; example: string }[] }[] | undefined;
        for (let attempt = 0; attempt < 4; attempt++) {
          translationController.signal.throwIfAborted();
          const response = await fetch(`${dictionaryApi}/dictionary/translate`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ entry_id: dictionaryEntry.id, content_hash: dictionaryEntry.content_hash }),
            signal: translationController.signal,
          });
          const data = await response.json();
          if (response.status === 202) {
            await new Promise(resolve => window.setTimeout(resolve, 3000));
            continue;
          }
          if (!response.ok || data.status !== 'ready') throw new Error(data.status || data.error || 'translation');
          content = data.content;
          break;
        }
        if (!content) throw new Error('processing');
        if (current !== revision) return;
        panels.ko.replaceChildren();
        for (const meaning of content) {
          const group = addText(panels.ko, 'div', '', 'space-y-1');
          addText(group, 'strong', meaning.partOfSpeech);
          const list = addText(group, 'ol', '', 'list-decimal pl-5 space-y-2');
          for (const definition of meaning.definitions) {
            const item = addText(list, 'li', definition.definition);
            if (definition.example) addText(item, 'p', definition.example, 'mt-1 text-gray-500');
          }
        }
        addText(panels.ko, 'p', '자동 번역 · 정확한 표현은 영어 원문을 확인해주세요.', 'text-xs text-gray-500');
        translated = true;
      } catch (error) {
        if (current !== revision) return;
        panels.ko.replaceChildren();
        const code = error instanceof Error ? error.message : '';
        const message = code === 'disabled' ? '한국어 번역은 준비 중입니다.'
          : code === 'limit' ? '현재 번역 사용 한도에 도달했습니다.'
          : code === 'changed' ? '사전 내용이 갱신되었습니다. 단어를 다시 검색해주세요.'
          : code === 'processing' ? '번역을 처리 중입니다. 잠시 후 다시 시도해주세요.'
          : '번역을 불러오지 못했습니다.';
        addText(panels.ko, 'p', `${message} 영어 탭에서 원문을 볼 수 있습니다.`, 'text-gray-500');
        const retry = addText(panels.ko, 'button', '다시 시도', 'text-sky-700 underline') as HTMLButtonElement;
        retry.type = 'button';
        retry.addEventListener('click', () => { if (!translating) void translateKorean(); });
      } finally { clearTimeout(translationTimeout); translating = false; panels.ko.setAttribute('aria-busy', 'false'); }
    };
    for (const language of ['ko', 'en'] as const) {
      const button = addText(tablist, 'button', language === 'ko' ? '한국어' : 'English') as HTMLButtonElement;
      button.type = 'button';
      button.id = `word-tab-${language}`;
      button.dataset.language = language;
      button.setAttribute('role', 'tab');
      button.setAttribute('aria-controls', `word-panel-${language}`);
      panels[language].id = `word-panel-${language}`;
      panels[language].lang = language;
      panels[language].tabIndex = 0;
      panels[language].setAttribute('role', 'tabpanel');
      panels[language].setAttribute('aria-labelledby', button.id);
      button.addEventListener('click', () => selectLanguage(language));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 'ko' : event.key === 'End' ? 'en' : language === 'ko' ? 'en' : 'ko';
        selectLanguage(next);
        tabs.find((tab) => tab.dataset.language === next)?.focus();
      });
      tabs.push(button);
    }
    selectLanguage('en');
    addText(panels.ko, 'p', '영어 뜻을 불러온 뒤 한국어 탭을 선택해주세요.', 'text-gray-500');
    let audioUrl = '';
    play.addEventListener('click', async () => {
      play.disabled = true;
      try {
        let url = audioUrl;
        if (!url) {
          const response = await fetch(`https://api.daparapara.com/tts?text=${encodeURIComponent(word)}&lang=en-US`, { signal: AbortSignal.timeout(12000) });
          if (!response.ok) throw new Error('tts');
          url = (await response.json()).url;
        }
        if (current !== revision) return;
        if (!url || new URL(url).protocol !== 'https:') throw new Error('audio');
        audio?.pause();
        audio = new Audio(url);
        await audio.play();
      } catch {
        if (current === revision) status.textContent = '발음을 재생하지 못했습니다. 다시 눌러주세요.';
      } finally { play.disabled = false; }
    });

    document.querySelectorAll<HTMLElement>('[data-pagefind-body] .vocab-item[data-word]').forEach((item) => {
      if (item.dataset.word?.trim().toLowerCase() !== word.toLowerCase()) return;
      const meaning = item.querySelector('.vocab-meaning')?.textContent?.trim();
      if (!meaning) return;
      if (!hasLocal) panels.ko.replaceChildren();
      hasLocal = true;
      addText(panels.ko, 'p', meaning);
      const example = item.querySelector('.vocab-example')?.textContent?.trim();
      if (example) addText(panels.ko, 'p', example, 'text-gray-600');
    });

    try {
      if (hasLocal) { status.textContent = '이 글의 핵심 어휘'; selectLanguage('ko'); }
      let response: Response;
      let data;
      let resolvedWord = word;
      try {
        response = await fetch(`${dictionaryApi}/dictionary?word=${encodeURIComponent(word)}`, {
          signal: AbortSignal.any([controller.signal, AbortSignal.timeout(11000)]),
        });
        if (!response.ok && response.status !== 404) throw new Error('dictionary');
        data = await response.json();
        if (data.lookup_key) resolvedWord = data.lookup_key;
        if (data.id && data.content_hash) dictionaryEntry = { id: data.id, content_hash: data.content_hash };
        if (Array.isArray(data.content)) data.en = data.content.map((meaning) => ({
          partOfSpeech: meaning.partOfSpeech,
          definitions: meaning.definitions.map((item) => ({ definition: item.definition, examples: [item.example] })),
        }));
      } catch {
        response = await fetch(`https://en.wiktionary.org/api/rest_v1/page/definition/${encodeURIComponent(word)}`, { signal: controller.signal });
        data = response.ok ? await response.json() : {};
        if ((response.status === 404 || (response.ok && !data.en?.length)) && word !== word.toLowerCase()) {
          resolvedWord = word.toLowerCase();
          response = await fetch(`https://en.wiktionary.org/api/rest_v1/page/definition/${encodeURIComponent(resolvedWord)}`, { signal: controller.signal });
          data = response.ok ? await response.json() : {};
        }
      }
      if (current !== revision) return;
      if (response.status === 404) { status.textContent = '사전에서 찾지 못했습니다. 철자나 단어의 기본형을 확인해주세요.'; return; }
      if (!response.ok) throw new Error('dictionary');
      if (current !== revision) return;
      if (!Array.isArray(data.en) || !data.en.length) { status.textContent = '등록된 영어 뜻이 없습니다.'; return; }
      const plainText = (html: string) => new DOMParser().parseFromString(html, 'text/html').body.textContent ?? '';
      const entries = [{ meanings: data.en.map((meaning) => ({
        partOfSpeech: meaning.partOfSpeech,
        definitions: meaning.definitions.map((definition) => ({
definition: dictionaryEntry ? definition.definition : plainText(definition.definition),
example: definition.examples?.[0] ? (dictionaryEntry ? definition.examples[0] : plainText(definition.examples[0])) : '',
        })),
      })) }];
      let count = 0;
      for (const entry of entries.slice(0, 3)) {
        for (const meaning of entry.meanings ?? []) {
          const group = addText(panels.en, 'div', '', 'space-y-1');
          addText(group, 'strong', meaning.partOfSpeech ?? '');
          const list = addText(group, 'ol', '', 'list-decimal pl-5 space-y-2');
          for (const definition of (meaning.definitions ?? []).slice(0, 3)) {
            if (!definition.definition) continue;
            const item = addText(list, 'li', definition.definition);
            if (definition.example) addText(item, 'p', definition.example, 'mt-1 text-gray-500');
            count++;
          }
        }
      }
      const source = document.createElement('a');
      source.href = `https://en.wiktionary.org/wiki/${encodeURIComponent(resolvedWord)}#English`;
      source.target = '_blank';
      source.rel = 'noopener noreferrer';
      source.textContent = '출처: Wiktionary · CC BY-SA 4.0';
      source.className = 'inline-block text-xs text-gray-500 underline';
      result.append(source);
      englishReady = count > 0;
      if (!hasLocal && tabs[0].getAttribute('aria-selected') === 'true') void translateKorean();
      status.textContent = count ? '영영사전 검색 결과' : '등록된 뜻이 없습니다.';
    } catch {
      if (current === revision) status.textContent = '사전에 연결하지 못했습니다. 잠시 후 다시 검색해주세요.';
    } finally {
      clearTimeout(timeout);
      if (current === revision) result.setAttribute('aria-busy', 'false');
    }
  });
</script>
